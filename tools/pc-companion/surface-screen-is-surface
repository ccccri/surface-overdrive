#!/bin/bash
# surface-screen-is-surface: succeeds when the Moonlight client connected to Sunshine now is the Surface: one of its Tailscale
# addresses, the address Tailscale reaches it at (Moonlight may also come straight over IPv6), or a client asking for a 3:2
# screen like the Surface's own (phones and PCs ask for 16:9 or narrower). Its Wi-Fi address is random, so the home
# network alone does not tell it.
client=$(ss -Htn state established '( sport = :47984 or sport = :47989 or sport = :48010 )' 2>/dev/null |
    awk '{print $4}' | sed -E 's/^\[?([^]]*)\]?:[0-9]+$/\1/; s/^::ffff://' | tail -1)
surface_ips=$(tailscale status --json 2>/dev/null | jq -r '.Peer[] | select(.HostName | test("^surface$"; "i"))
    | .TailscaleIPs[], (.CurAddr // "" | sub(":[0-9]+$"; "") | ltrimstr("[") | rtrimstr("]") | select(. != ""))')
[ -n "$client" ] && printf '%s\n' $surface_ips | grep -qixF "$client" && exit 0
W=${SUNSHINE_CLIENT_WIDTH:-0} H=${SUNSHINE_CLIENT_HEIGHT:-0}
[ "$W" -gt 0 ] && [ $((W * 2)) -eq $((H * 3)) ]
