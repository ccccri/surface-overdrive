#!/bin/bash
# surface-screen-map <output>: Sunshine's touch screen and pen tablet on that screen, as soon as they are there (they may come a
# moment after the session starts), for up to 30 s, in the background. KWin maps them to the first monitor otherwise, and KWin
# keeps the mapping by the id of the screen, which is new for every virtual screen: so it is set at every session.
out=${1:?usage: surface-screen-map <output>}
(
for _ in $(seq 60); do
    mapped=0
    for dev in $(busctl --user tree org.kde.KWin --list 2>/dev/null | grep '/org/kde/KWin/InputDevice/event'); do
        case "$(busctl --user get-property org.kde.KWin "$dev" org.kde.KWin.InputDevice name 2>/dev/null)" in
        *"libvirtualhid Touchscreen"* | *"libvirtualhid Pen Tablet"*)
            busctl --user set-property org.kde.KWin "$dev" org.kde.KWin.InputDevice outputName s "$out" && mapped=$((mapped + 1)) ;;
        esac
    done
    [ "$mapped" -ge 2 ] && exit 0
    sleep 0.5
done
) >/dev/null 2>&1 &
