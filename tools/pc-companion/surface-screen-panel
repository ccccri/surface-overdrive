#!/bin/bash
# surface-screen-panel desktop|normal: the panels of the main screen as the user keeps them for each use.
# With Desktop (remote) the Surface is the PC's only screen and gets the main screen's panel, which at the monitor is a
# bar along the bottom: on the Surface's 3:2 screen the user keeps it on the left. Each use has its own position and
# thickness, remembered when it ends (a change made during a session stays for the next one):
# - desktop: the "normal" ones are kept, the Desktop ones applied (left, as thick as it was, the first time);
# - normal: the Desktop ones are kept, the normal ones applied.
# Kept in ~/.local/state/surface-screen/panel-{normal,desktop}. Plasma's scripting interface (evaluateScript) does it.
STATE=$HOME/.local/state/surface-screen
mkdir -p "$STATE"
QDBUS=$(command -v qdbus-qt6 || command -v qdbus6 || command -v qdbus)
script() { "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$1" 2>/dev/null; }

# the main screen's panels as "location thickness" (the first one: Plasma has one there unless the user added more)
current() {
    script 'var p = panels().filter(function (p) { return p.screen == 0; })[0]; print(p ? p.location + " " + p.height : "");'
}
apply() {  # <location> <thickness>
    case "$1" in top | bottom | left | right) ;; *) return ;; esac
    case "$2" in '' | *[!0-9]*) return ;; esac
    script "panels().filter(function (p) { return p.screen == 0; }).forEach(function (p) { p.location = \"$1\"; p.height = $2; });"
}

case "${1:-}" in
desktop)
    now=$(current); [ -n "$now" ] || exit 0
    echo "$now" > "$STATE/panel-normal"
    read -r loc h < <(cat "$STATE/panel-desktop" 2>/dev/null || echo "left ${now#* }")
    apply "$loc" "$h" ;;
normal)
    [ -f "$STATE/panel-normal" ] || exit 0
    now=$(current); [ -n "$now" ] && echo "$now" > "$STATE/panel-desktop"
    read -r loc h < "$STATE/panel-normal"
    apply "$loc" "$h"
    rm -f "$STATE/panel-normal" ;;
*) echo "usage: surface-screen-panel desktop|normal" >&2; exit 2 ;;
esac
exit 0
