#!/bin/bash
# sunshine-sinks [session|trim|off]: Sunshine's virtual sound output, one, with a name a person can read, and only while a
# stream runs.
#
# Sunshine makes three null sinks when it starts, "sink-sunshine-stereo", "-surround51" and "-surround71", each shown so in
# every sound menu, and records from the one matching the client's channels, by name. It takes an existing sink of the
# same name instead of making it, and makes missing ones again when a session starts.
#   (no argument) the stereo one is made as "Surface Stereo Out"; a sink Sunshine left behind (it carries its name as
#     description) is replaced.
#   session (global prep, before every app) the stereo one is made here first, and the other two go 10 s after the start:
#     every client here streams stereo (a client asking for 5.1 or 7.1 would get no sound).
#   trim the 5.1 and 7.1 ones are unloaded (Sunshine's own unload of them then fails, harmlessly).
#   off (Sunshine started or stopped, a session over) all three are unloaded: no "Surface Stereo Out" in the sound menus
#     while nothing streams. At Sunshine's start it waits up to 30 s for Sunshine to have made them.
DESC="Surface Stereo Out"
sinks() { pactl -f json list sinks 2>/dev/null; }
unload() {  # <sink name>: the module that made it
    sinks | jq -r --arg n "$1" '.[] | select(.name == $n) | .owner_module' | grep -v 4294967295 |
        xargs -r -n1 pactl unload-module 2>/dev/null
}
if [ "${1:-}" = session ]; then
    "$0"
    systemd-run --user --collect --quiet --on-active=10 "$(readlink -f "$0")" trim 2>/dev/null
    exit 0
fi
if [ "${1:-}" = off ]; then
    for _ in $(seq 60); do   # Sunshine just started: its three sinks come within a few seconds
        [ "${2:-}" = wait ] || break
        sinks | jq -e '[.[] | select(.name | test("^sink-sunshine-(stereo|surround51|surround71)$"))] | length == 3' >/dev/null && break
        sleep 0.5
    done
    unload sink-sunshine-stereo
    unload sink-sunshine-surround51
    unload sink-sunshine-surround71
    exit 0
fi
if [ "${1:-}" = trim ]; then
    for _ in $(seq 60); do
        sinks | jq -e '[.[] | select(.name | test("^sink-sunshine-surround(51|71)$"))] | length == 2' >/dev/null && break
        sleep 0.5
    done
    unload sink-sunshine-surround51
    unload sink-sunshine-surround71
    exit 0
fi
desc=$(sinks | jq -r '.[] | select(.name == "sink-sunshine-stereo") | .description' | head -1)
[ "$desc" = "$DESC" ] && exit 0
[ -n "$desc" ] && unload sink-sunshine-stereo
pactl load-module module-null-sink rate=48000 sink_name=sink-sunshine-stereo format=float channels=2 \
    channel_map=front-left,front-right "sink_properties=device.description=\"${DESC// /\\ }\"" >/dev/null
exit 0
