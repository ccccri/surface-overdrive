#!/bin/bash
# sunshine-sinks: Sunshine's three virtual sound outputs, made before Sunshine starts (ExecStartPre) with names a person can
# read. Sunshine makes them itself as "sink-sunshine-stereo", "sink-sunshine-surround51" and "sink-sunshine-surround71",
# shown so in every sound menu; it takes an existing sink of the same name instead (and unloads it when it quits, so they
# are made again at every start). The arguments are Sunshine's own, but for the description.
# Run while Sunshine is stopped: a sink Sunshine made itself and left behind (stopped with a kill, it does not unload them)
# carries its name as description, and is replaced.
add() {  # <name> <channels> <channel map> <description>
    local desc
    desc=$(pactl -f json list sinks 2>/dev/null | jq -r --arg n "$1" '.[] | select(.name == $n) | .description' | head -1)
    [ -n "$desc" ] && [ "$desc" != "$1" ] && return
    if [ -n "$desc" ]; then
        pactl -f json list sinks | jq -r --arg n "$1" '.[] | select(.name == $n) | .owner_module' |
            xargs -r -n1 pactl unload-module 2>/dev/null
    fi
    pactl load-module module-null-sink rate=48000 "sink_name=$1" format=float "channels=$2" "channel_map=$3" \
        "sink_properties=device.description=\"${4// /\\ }\"" >/dev/null
}
add sink-sunshine-stereo 2 front-left,front-right "Stream to Moonlight"
add sink-sunshine-surround51 6 front-left,front-right,front-center,lfe,rear-left,rear-right "Stream to Moonlight 5.1"
add sink-sunshine-surround71 8 front-left,front-right,front-center,lfe,rear-left,rear-right,side-left,side-right \
    "Stream to Moonlight 7.1"
exit 0
