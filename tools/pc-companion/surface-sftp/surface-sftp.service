[Unit]
Description=The PC's files for the Surface over SFTP (Tailscale only, the Surface's key only)
After=network-online.target

[Service]
ExecStart=/usr/sbin/sshd -D -e -f %h/.config/surface-sftp/sshd_config
# the Tailscale address may come up after the session starts
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
