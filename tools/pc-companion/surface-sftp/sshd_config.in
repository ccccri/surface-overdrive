# surface-sftp: the PC's files for the Surface, in its Dolphin (sftp://dsktp). An sshd of the user's own, not the system's
# (which stays off): it listens only on the PC's Tailscale address, lets in only the Surface's key, and gives it nothing
# but SFTP, as this user. Made by install.sh from sshd_config.in (@DIR@, @ADDR@).
ListenAddress @ADDR@:2222
HostKey @DIR@/host_ed25519
PidFile none
AuthorizedKeysFile @DIR@/authorized_keys
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
UsePAM no
StrictModes yes
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
PermitUserRC no
GatewayPorts no
ForceCommand internal-sftp
Subsystem sftp internal-sftp
LogLevel INFO
