#!/usr/bin/python3
"""add-place <url> <title> <icon>: a place in Dolphin's side panel (and every file dialog's), once.

KDE keeps the places in ~/.local/share/user-places.xbel; a bookmark with the same URL is left as it is."""
import os
import sys
import xml.etree.ElementTree as ET

url, title, icon = sys.argv[1:4]
path = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "user-places.xbel")
ns = {"bookmark": "http://www.freedesktop.org/standards/desktop-bookmarks",
      "mime": "http://www.freedesktop.org/standards/shared-mime-info",
      "kdepriv": "http://www.kde.org/kdepriv"}
for k, v in ns.items():
    ET.register_namespace(k, v)
if os.path.exists(path):
    tree = ET.parse(path)
    root = tree.getroot()
else:
    root = ET.Element("xbel")
    tree = ET.ElementTree(root)
if any(b.get("href") == url for b in root.iter("bookmark")):
    print("place already there:", url)
    sys.exit(0)
b = ET.SubElement(root, "bookmark", href=url)
ET.SubElement(b, "title").text = title
info = ET.SubElement(ET.SubElement(b, "info"), "metadata", owner="http://freedesktop.org")
ET.SubElement(info, "{%s}icon" % ns["bookmark"], name=icon)
tree.write(path + ".tmp", encoding="UTF-8", xml_declaration=True)
os.replace(path + ".tmp", path)
print("place added:", title, url)
