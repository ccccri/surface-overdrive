#!/bin/bash
# surface-screen-where: prints "home" or "away" for the Moonlight client connected to Sunshine now (Extended Display is for
# home).
# The client is found among the TCP connections to Sunshine's ports; a client on the PC's own networks (a private IPv4 address,
# or IPv6 in one of the PC's /64 prefixes) is at home; one over Tailscale is at home when Tailscale reaches it directly on
# such an address, away otherwise (another network, or a relay). Unknown: "home" (the screen is then only added).
private4() { case "$1" in 10.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].*) return 0 ;; esac; return 1; }
prefix64() { python3 -c 'import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1]+"/64",strict=False))' "$1" 2>/dev/null; }
local_nets() { ip -6 -o addr show scope global | awk '{print $4}' | while read -r a; do prefix64 "${a%/*}"; done; }
on_home_network() {  # an address (IPv4 or IPv6, no port)
    private4 "$1" && return 0
    case "$1" in *:*) local_nets | grep -qxF "$(prefix64 "$1")" && return 0 ;; esac
    return 1
}
client=${1:-$(ss -Htn state established '( sport = :47984 or sport = :47989 or sport = :48010 )' 2>/dev/null |
    awk '{print $4}' | sed -E 's/^\[?([^]]*)\]?:[0-9]+$/\1/; s/^::ffff://' | tail -1)}
[ -n "$client" ] || { echo home; exit 0; }
case "$client" in
100.*|fd7a:115c:a1e0:*)
    cur=$(tailscale status --json 2>/dev/null | jq -r --arg ip "$client" '.Peer[] | select(.TailscaleIPs | index($ip)) | .CurAddr // ""')
    addr=$(printf '%s' "$cur" | sed -E 's/^\[?([^]]*)\]?:[0-9]+$/\1/')
    if [ -n "$addr" ] && on_home_network "$addr"; then echo home; else echo away; fi ;;
*)
    if on_home_network "$client"; then echo home; else echo away; fi ;;
esac
