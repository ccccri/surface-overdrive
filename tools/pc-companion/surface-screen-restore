#!/bin/bash
# surface-screen-restore: what a session from the Surface changed, back as it was: the PC's monitors on, Plasma's tablet
# mode setting, the on-screen keyboard's width.
# Run at the end of the session, or 2 minutes after a client went away without quitting.
OFFFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.off
TABLETFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.tablet
if [ -s "$OFFFILE" ]; then
    args=(); while read -r o; do args+=("output.$o.enable"); done < "$OFFFILE"
    kscreen-doctor "${args[@]}" >/dev/null 2>&1
    "$(dirname "$0")/surface-screen-osk"      # back to the width of the PC's monitor
    "$(dirname "$0")/surface-screen-panel" normal   # the panel back where the user keeps it at the monitor
fi
rm -f "$OFFFILE"
if [ -f "$TABLETFILE" ]; then
    old=$(cat "$TABLETFILE")
    if [ -n "$old" ]; then kwriteconfig6 --notify --file kwinrc --group Input --key TabletMode "$old"
    else kwriteconfig6 --notify --file kwinrc --group Input --key TabletMode --delete; fi
    rm -f "$TABLETFILE"
fi
OSKFILL=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.oskfill
if [ -f "$OSKFILL" ]; then
    old=$(cat "$OSKFILL")
    if [ -n "$old" ]; then kwriteconfig6 --notify --file plasmakeyboardrc --group General --key panelFillScreenWidth "$old"
    else kwriteconfig6 --notify --file plasmakeyboardrc --group General --key panelFillScreenWidth --delete; fi
    rm -f "$OSKFILL"
fi
