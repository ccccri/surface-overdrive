#!/bin/bash
# surface-screen-stop: Sunshine runs it (prep "undo") when the Surface disconnects: the PC's monitors back on (if a "Desktop"
# session turned them off), the virtual screen gone (its scale kept for the next session of the same kind), Sunshine back to
# capturing the PC's own monitor. Also the global prep "do" of every app: whatever a session left behind (Sunshine stopped
# in the middle, a crash) is cleared before a phone or a game stream starts. Doing nothing when there is nothing left.
CONF=$HOME/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine/sunshine.conf
PIDFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.pid
MODEFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.mode
if [ -s "$MODEFILE" ]; then
    scale=$(kscreen-doctor --json 2>/dev/null | jq -r '.outputs[] | select(.name == "Virtual-surface") | .scale')
    [ -n "$scale" ] && mkdir -p "$HOME/.local/state/surface-screen" &&
        echo "$scale" > "$HOME/.local/state/surface-screen/scale-$(cat "$MODEFILE")"
fi
rm -f "$MODEFILE"
# what an away session changed comes back first (the monitors, so that windows return to them; tablet mode)
"$(dirname "$0")/surface-screen-restore"
[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
rm -f "$PIDFILE"
pkill -f "bash [^ ]*/surface-screen-map " 2>/dev/null
pkill -f "krfb-virtualmonitor .*--name surface( |\$)" 2>/dev/null
grep -q '^output_name' "$CONF" && sed -i '/^output_name/d' "$CONF"
exit 0   # a prep "do" that fails stops the stream
