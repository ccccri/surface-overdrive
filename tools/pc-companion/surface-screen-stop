#!/bin/bash
# surface-screen-stop: Sunshine runs it (prep "undo") when the Surface disconnects: the PC's monitors back on (if a
# "Desktop" session turned them off), the virtual screen and its loops gone (Sunshine falls back to the PC's own monitor).
# Also the global prep "do" of every app: whatever a session left behind (Sunshine stopped in the middle, a crash) is
# cleared before a phone or a game stream starts. Doing nothing when there is nothing left.
PIDFILE=${XDG_RUNTIME_DIR:-/tmp}/surface-screen.pid
# what a "only" session changed comes back first (the monitors, so that windows return to them; tablet mode)
"$(dirname "$0")/surface-screen-restore"
[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
rm -f "$PIDFILE"
pkill -f "bash [^ ]*/surface-screen-(map|start)( |$)" 2>/dev/null
pkill -f "krfb-virtualmonitor .*--name surface( |\$)" 2>/dev/null
exit 0   # a prep "do" that fails stops the stream
