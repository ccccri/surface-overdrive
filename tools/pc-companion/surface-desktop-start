#!/bin/bash
# surface-desktop-start: Sunshine runs it (prep "do" of the "Desktop" app). From the Surface, "Desktop" is the same as "Surface
# Screen" (a screen of its own size, a second screen at home, the only one away): the PC's 16:9 monitor squeezed into the
# Surface's 3:2 screen was small and touch went astray. From any other client (a phone), the PC's main monitor as it is, with
# Sunshine's touch screen and pen tablet mapped to it.
here=$(dirname "$0")
client=$(ss -Htn state established '( sport = :47984 or sport = :47989 or sport = :48010 )' 2>/dev/null |
    awk '{print $4}' | sed -E 's/^\[?([^]]*)\]?:[0-9]+$/\1/; s/^::ffff://' | tail -1)
surface_ips=$(tailscale status --json 2>/dev/null | jq -r '.Peer[] | select(.HostName | test("^surface$"; "i")) | .TailscaleIPs[]')
MARK=${XDG_RUNTIME_DIR:-/tmp}/surface-desktop.surface
if [ -n "$client" ] && printf '%s\n' $surface_ips | grep -qxF "$client"; then
    touch "$MARK"
    exec "$here/surface-screen-start"
fi
rm -f "$MARK"
main=$(kscreen-doctor --json | jq -r '[.outputs[] | select(.enabled)] | (map(select(.priority == 1)) + .)[0].name')
"$here/surface-screen-map" "$main"
