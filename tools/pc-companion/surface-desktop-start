#!/bin/bash
# surface-desktop-start: Sunshine runs it (prep "do" of the "Desktop" app). From the Surface, the remote desktop: a screen of
# the Surface's size as the PC's only screen, in tablet mode (surface-screen-start only). From any other client (a phone,
# another PC, games), the PC's main monitor as it is, with Sunshine's touch screen and pen tablet mapped to it.
here=$(dirname "$0")
MARK=${XDG_RUNTIME_DIR:-/tmp}/surface-desktop.surface
if "$here/surface-screen-is-surface"; then
    touch "$MARK"
    exec "$here/surface-screen-start" only
fi
rm -f "$MARK"
main=$(kscreen-doctor --json | jq -r '[.outputs[] | select(.enabled)] | (map(select(.priority == 1)) + .)[0].name')
"$here/surface-screen-map" "$main"
