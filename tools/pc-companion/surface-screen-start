#!/bin/bash
# surface-screen-start [extend|only]: Sunshine runs it (prep "do") when the Surface connects. A virtual screen of the size the
# client asks for, with Sunshine's touch screen, pen tablet and absolute mouse mapped to it; Sunshine captures it by name
# (output_name = Virtual-surface in sunshine.conf: without it, the PC's monitor when it is on).
# - extend ("Extended Display", at home): a second screen below the PC's main monitor and centred, the monitor stays on.
#   Away from home the Surface asks whether to open the remote desktop instead (other clients: refused).
# - only ("Desktop" from the Surface, for remote use): the only screen, the PC's monitors off and Plasma's tablet mode for
#   the session, all back at its end (or 2 minutes after the client went away without quitting).
# The screen is always at 100%: the portal gives Sunshine a scaled screen at its logical size, and the picture came out
# cropped or shrunk. Bigger text is a smaller screen that the Surface enlarges: a scale set in System Settings during a
# session is turned into that at once and kept for the next session of the same kind (~/.local/state/surface-screen).
# Bazzite's sunshine-start-vmon does the same for game streaming but always turns every other monitor off.
set -u
here=$(dirname "$0")
MODE=${1:-extend}
case "$MODE" in extend | only) ;; *) echo "usage: surface-screen-start [extend|only]" >&2; exit 2 ;; esac
W=${SUNSHINE_CLIENT_WIDTH:-1800}
H=${SUNSHINE_CLIENT_HEIGHT:-1200}
NAME=surface
OUT=Virtual-$NAME
RUN=${XDG_RUNTIME_DIR:-/tmp}
PIDFILE=$RUN/surface-screen.pid
OFFFILE=$RUN/surface-screen.off       # monitors turned off for a "only" session
TABLETFILE=$RUN/surface-screen.tablet # Plasma's tablet mode setting before a "only" session
STATE=$HOME/.local/state/surface-screen
LOG=$HOME/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine/sunshine.log
log() { echo "$(date +%T) $*" >> "$RUN/surface-screen.log"; }
log "client ${SUNSHINE_CLIENT_WIDTH:-?}x${SUNSHINE_CLIENT_HEIGHT:-?}@${SUNSHINE_CLIENT_FPS:-?}, $MODE"

# Extended Display away from home: nobody sits at the PC's monitor. The Surface is asked (a dialog over Moonlight's
# "starting" screen); any other client is refused, and Moonlight says the app could not start.
ask_surface() {  # prints desktop, extend or nothing
    ssh -o BatchMode=yes -o ConnectTimeout=5 surface '
        eval "$(systemctl --user show-environment | grep -E "^(WAYLAND_DISPLAY|DBUS_SESSION_BUS_ADDRESS|XDG_RUNTIME_DIR)=" | sed "s/^/export /")"
        timeout 60 kdialog --title "Extended Display" --yes-label "Desktop" --no-label "Extended Display" --yesnocancel \
            "You are away from home: Extended Display adds the Surface as a second screen beside the PC'"'"'s monitor, and the PC'"'"'s monitor stays on.

Open the remote Desktop instead (the Surface as the PC'"'"'s only screen)?"
        case $? in 0) echo desktop ;; 1) echo extend ;; esac' 2>/dev/null
}
if [ "$MODE" = extend ] && [ "$("$here/surface-screen-where")" = away ]; then
    if "$here/surface-screen-is-surface"; then
        case "$(ask_surface)" in
        desktop) MODE=only; log "away: Desktop instead" ;;
        extend) log "away: Extended Display anyway" ;;
        *) log "away: cancelled"; exit 1 ;;
        esac
    else
        log "away: refused (not the Surface)"; exit 1
    fi
fi

# a screen left by an earlier session (a client that went away without quitting the app) goes first: two would be made;
# and the loops of that session with it
[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
pkill -f "krfb-virtualmonitor .*--name $NAME( |\$)" 2>/dev/null
for p in $(pgrep -f "bash [^ ]*/surface-screen-start"); do [ "$p" != $$ ] && kill "$p" 2>/dev/null; done
exists() { kscreen-doctor --json 2>/dev/null | jq -e --arg o "$OUT" '.outputs[] | select(.name == $o)' >/dev/null; }
for _ in $(seq 25); do exists || break; sleep 0.2; done

# the zoom: the Surface's size divided by it is the screen's (1 = pixel for pixel); a scale kept by the version before is taken
ZOOMFILE=$STATE/zoom-$MODE
[ -f "$ZOOMFILE" ] || { [ -f "$STATE/scale-$MODE" ] && mv "$STATE/scale-$MODE" "$ZOOMFILE"; }
ZOOM=$(cat "$ZOOMFILE" 2>/dev/null)
case "$ZOOM" in '' | *[!0-9.]*) ZOOM=1 ;; esac
size() { awk -v w="$W" -v h="$H" -v z="$1" 'BEGIN { if (z < 1) z = 1; printf "%d %d", int(w / z / 2 + 0.5) * 2, int(h / z / 2 + 0.5) * 2 }'; }
read -r VW VH < <(size "$ZOOM")
log "zoom $ZOOM: ${VW}x${VH}"

# krfb-virtualmonitor makes the KWin output (its VNC server is not used: a random password keeps it closed)
krfb-virtualmonitor --resolution "${VW}x${VH}" --scale 1 --name "$NAME" \
    --password "$(head -c 18 /dev/urandom | base64)" --port 5906 >/dev/null 2>&1 &
echo $! > "$PIDFILE"
for _ in $(seq 50); do exists && break; sleep 0.2; done

# The mode KWin gives it depends on what it remembers for that name (800x533 or 1200x800 came out): the size is chosen by
# hand, added once if it is not there; at 100%, below the PC's main monitor and centred (extend) or at 0,0 (only).
apply() {  # <width> <height>
    local m pos
    m=$(kscreen-doctor --json | jq -r --arg o "$OUT" --argjson w "$1" --argjson h "$2" \
        '.outputs[] | select(.name == $o) | [.modes[] | select(.size.width == $w and .size.height == $h)] | last | .id // empty')
    if [ -z "$m" ]; then
        kscreen-doctor "output.$OUT.addCustomMode.$1.$2.60000.full" >/dev/null 2>&1
        m=$(kscreen-doctor --json | jq -r --arg o "$OUT" --argjson w "$1" --argjson h "$2" \
            '.outputs[] | select(.name == $o) | [.modes[] | select(.size.width == $w and .size.height == $h)] | last | .id // empty')
    fi
    pos=0,0
    [ "$MODE" = extend ] && pos=$(kscreen-doctor --json | jq -r --arg o "$OUT" --argjson w "$1" '
        [.outputs[] | select(.enabled and .name != $o)] | (map(select(.priority == 1)) + .)[0]
        | "\((.pos.x + (.size.width / .scale - $w) / 2) | round | if . < 0 then 0 else . end),\((.pos.y + .size.height / .scale) | ceil)"')
    # extend: the PC's monitor stays the primary screen (desktop icons, its panel, its wallpaper): KWin remembers the
    # virtual screen as primary from a Desktop session, where it was the only one
    local prio=()
    if [ "$MODE" = extend ]; then
        local main
        main=$(kscreen-doctor --json | jq -r --arg o "$OUT" '[.outputs[] | select(.enabled and .name != $o)] | sort_by(.priority) | .[0].name // empty')
        [ -n "$main" ] && prio=("output.$main.priority.1" "output.$OUT.priority.2")
    fi
    kscreen-doctor ${m:+"output.$OUT.mode.$m"} "output.$OUT.scale.1" "output.$OUT.position.${pos:-0,0}" "${prio[@]}" >/dev/null 2>&1
}
apply "$VW" "$VH"

if [ "$MODE" = extend ]; then
    # The on-screen keyboard (plasma-keyboard) takes the width of the screen it starts on, the monitor, and KWin centres it
    # on the Surface, narrower: its sides were cut off. Not filling the screen width it is three times its height (about
    # 1150 px from the monitor's height), which fits. Put back at the end (surface-screen-restore).
    printf '%s\n' "$(kreadconfig6 --file plasmakeyboardrc --group General --key panelFillScreenWidth)" > "$RUN/surface-screen.oskfill"
    kwriteconfig6 --notify --file plasmakeyboardrc --group General --key panelFillScreenWidth false
fi

if [ "$MODE" = only ]; then
    # only: the Surface is the only screen, every window on it; the monitors that were on are noted to come back
    kscreen-doctor --json | jq -r --arg o "$OUT" '.outputs[] | select(.enabled and .name != $o) | .name' > "$OFFFILE"
    args=(); while read -r o; do args+=("output.$o.disable"); done < "$OFFFILE"
    [ ${#args[@]} -gt 0 ] && kscreen-doctor "${args[@]}" >/dev/null 2>&1
    # Plasma's tablet mode for the session (bigger targets, the on-screen keyboard on text fields): the Surface has no
    # keyboard. The setting it had is kept to be put back.
    printf '%s\n' "$(kreadconfig6 --file kwinrc --group Input --key TabletMode)" > "$TABLETFILE"
    kwriteconfig6 --notify --file kwinrc --group Input --key TabletMode on
    "$here/surface-screen-osk"
    # and they come back by themselves when the Surface went away without quitting (no client for 2 minutes): the PC's own
    # monitor is not left dark
    (
    while [ -s "$OFFFILE" ]; do
        sleep 15
        last=$(grep -E 'CLIENT (CONNECTED|DISCONNECTED)' "$LOG" | tail -1)
        case "$last" in *DISCONNECTED*) ;; *) continue ;; esac
        when=$(date -d "$(printf '%s' "$last" | sed -E 's/^\[([^]]+)\].*/\1/')" +%s 2>/dev/null) || continue
        [ $(( $(date +%s) - when )) -ge 120 ] || continue
        "$here/surface-screen-restore"
    done
    ) >/dev/null 2>&1 &
fi

# Sound. Sunshine makes its own sink the default when a stream starts, records the default sink whatever it is, and at
# the end puts back the default it found when it started (not the one in use: Bluetooth headphones were lost).
# - Extended Display is at home, by the PC: Sunshine's switch at the start is undone once (the sound stays on the PC's
#   speakers or headphones); after that the user's choice stands. With a sink of the PC chosen, Sunshine records its own
#   stereo sink, which nothing plays to (the sound came out of the Surface too); with one of Sunshine's (stereo, 5.1, 7.1)
#   it records that one, and the sound goes to the Surface.
# - Desktop (remote) keeps Sunshine's sink: the sound goes to the Surface.
# The default before the session is kept for surface-screen-stop, which puts it back after Sunshine's own.
home_sink=$(pactl get-default-sink 2>/dev/null)
case "$home_sink" in sink-sunshine*)   # left by a session that ended badly: the first sink that is not Sunshine's
    home_sink=$(pactl list short sinks 2>/dev/null | awk '$2 !~ /^sink-sunshine/ {print $2; exit}') ;;
esac
[ -n "$home_sink" ] && echo "$home_sink" > "$RUN/surface-screen.sink"
pin_recording() {  # Sunshine's recording on the monitor of $1
    pactl -f json list source-outputs 2>/dev/null | jq -r --arg want "$1.monitor" --argjson srcs \
        "$(pactl -f json list sources 2>/dev/null || echo '[]')" '
        ($srcs | map({key: (.index | tostring), value: .name}) | from_entries) as $name
        | .[] | select(.properties["application.name"] == "sunshine") | select($name[(.source | tostring)] != $want) | .index' |
        while read -r i; do pactl move-source-output "$i" "$1.monitor" && log "sunshine records $1"; done
}

# a scale set in System Settings during the session becomes the zoom: back to 100% with a screen that much smaller
(
sleep 3
while exists; do
    if [ "$MODE" = extend ]; then
        cur=$(pactl get-default-sink 2>/dev/null)
        if [ -z "${undone:-}" ] && [ -n "$home_sink" ]; then
            case "$cur" in sink-sunshine*)
                pactl set-default-sink "$home_sink" && log "sound back to $home_sink"; cur=$home_sink; undone=1 ;;
            esac
        fi
        case "$cur" in
        sink-sunshine*) pin_recording "$cur" ;;
        ?*) pactl list short sinks 2>/dev/null | grep -q $'\tsink-sunshine-stereo\t' && pin_recording sink-sunshine-stereo ;;
        esac
    fi
    s=$(kscreen-doctor --json 2>/dev/null | jq -r --arg o "$OUT" '.outputs[] | select(.name == $o) | .scale')
    if [ -n "$s" ] && [ "$s" != 1 ]; then
        ZOOM=$(awk -v z="$ZOOM" -v s="$s" 'BEGIN { z *= s; if (z < 1) z = 1; if (z > 3) z = 3; printf "%.4g", z }')
        mkdir -p "$STATE" && echo "$ZOOM" > "$ZOOMFILE"
        read -r VW VH < <(size "$ZOOM")
        log "scale $s: zoom $ZOOM, ${VW}x${VH}"
        apply "$VW" "$VH"
    fi
    sleep 2
done
) >/dev/null 2>&1 &

# Sunshine's touch screen, pen tablet and absolute mouse on this screen (they went to the PC's own monitor otherwise)
"$here/surface-screen-map" "$OUT"

# the Surface's camera and microphone as the PC's, on demand, for the session (surface-av)
if "$here/surface-screen-is-surface"; then
    pkill -TERM -f "^/usr/bin/python3 [^ ]*/surface-av$" 2>/dev/null
    setsid "$here/surface-av" >/dev/null 2>&1 < /dev/null &
fi
