#!/usr/bin/python3
"""surface-av: the Surface's camera and microphone as the PC's own while the Surface is connected, used only on demand.

surface-screen-start runs it for a session from the Surface (Extended Display or Desktop) and surface-screen-stop ends it
(SIGTERM: everything is taken down, on both machines).

Camera: each v4l2loopback device ("OBS Virtual Camera" on Bazzite, or one per camera: README) always gets frames, so apps list it:
black while no app has it open, the Surface's front camera while one has (opens and closes of the device are counted with
inotify, which needs no permissions and sees apps in Flatpaks). The Surface's camera, and its light, are on only then:
PipeWire's libcamera node there, H.264 on its graphics chip, through ssh to the host "surface", decoded on the PC's.

Microphone: "Surface Microphone" is a PulseAudio tunnel to the Surface's microphone for the session (it follows the two
machines' clocks). Nobody recording, it is suspended and its stream on the Surface corked: the microphone is used only
while an app records. The Surface listens for it only on its Tailscale address, only to the PC's, only during the session.
"""
import ctypes
import json
import os
import signal
import struct
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gst", "1.0")
from gi.repository import GLib, Gst  # noqa: E402

W, H, FPS = 1280, 960, 30
SSH = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=5",
       "-o", "ServerAliveCountMax=3", "surface"]
FRONT = "libcamera_input.__SB_.PCI0.LNK1"    # the Surface's front camera
REAR = "libcamera_input.__SB_.PCI0.LNK0"     # and its rear one
MIC = "surface_mic"                          # the source apps see
PORT = 4713
LOG = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "surface-screen.log")


def log(msg):
    with open(LOG, "a") as f:
        f.write(time.strftime("%H:%M:%S") + " av: " + msg + "\n")


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=False)


def loopback_devices():
    """[(device, Surface camera)]: the v4l2loopback devices, the one labelled "...Rear..." for the rear camera, the first
    other one for the front camera (Bazzite's single "OBS Virtual Camera", or "Surface Front Camera" with the README's
    labels)."""
    base = "/sys/devices/virtual/video4linux"
    found = []
    for name in sorted(os.listdir(base), key=lambda n: int(n[5:]) if n[5:].isdigit() else 0) if os.path.isdir(base) else []:
        try:
            label = open(os.path.join(base, name, "name")).read().lower()
        except OSError:
            continue
        if "loopback" in label or "virtual" in label or "surface" in label:
            found.append(("/dev/" + name, label))
    rear = [d for d, label in found if "rear" in label][:1]
    front = [d for d, label in found if "rear" not in label][:1]
    return [(d, FRONT) for d in front] + [(d, REAR) for d in rear]


class Openers:
    """How many times other processes have the device open, from /proc (Flatpak apps too: Chromium's video capture
    process can be read). inotify's opens and closes only say when to look again: counted, they were wrong twice (an open
    of surface-av's own taken for an app's; and inotify merges two identical events in a row, so two closes counted as
    one), and the Surface's camera stayed on. Looked at again on every event, and every RESCAN_S anyway."""
    IN_OPEN, IN_CLOSE_WRITE, IN_CLOSE_NOWRITE = 0x20, 0x08, 0x10
    RESCAN_S = 5.0

    def __init__(self, path):
        self.path = path
        libc = ctypes.CDLL(None, use_errno=True)
        self.fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        libc.inotify_add_watch(self.fd, path.encode(), self.IN_OPEN | self.IN_CLOSE_WRITE | self.IN_CLOSE_NOWRITE)
        self.count = self.others()
        self.at = time.monotonic()

    def others(self):
        """Open descriptors of the device in every process but this one."""
        me = str(os.getpid())
        n = 0
        for p in filter(str.isdigit, os.listdir("/proc")):
            if p == me:
                continue
            try:
                fds = os.listdir(f"/proc/{p}/fd")
            except OSError:
                continue
            for fd in fds:
                try:
                    if os.readlink(f"/proc/{p}/fd/{fd}") == self.path:
                        n += 1
                except OSError:
                    pass
        return n

    def poll(self):
        try:
            changed = bool(os.read(self.fd, 65536))
        except BlockingIOError:
            changed = False
        if changed or time.monotonic() - self.at > self.RESCAN_S:
            self.at = time.monotonic()
            count = self.others()
            if count != self.count:
                log(f"camera device: open {count} times by apps")
            self.count = count
        return self.count


class Camera:
    def __init__(self, device, target):
        self.device = device
        self.target = target
        self.name = "rear camera" if target == REAR else "camera"
        self.latest = None
        self.latest_at = 0.0
        self.started = 0.0
        self.proc = None
        self.pipe = None
        self.black = Gst.Buffer.new_wrapped(b"\x10\x80\x10\x80" * (W * H // 2))   # YUY2 black
        caps = f"video/x-raw,format=YUY2,width={W},height={H},framerate={FPS}/1,pixel-aspect-ratio=1/1"
        # videoconvert in between: without it v4l2loopback refused the caps (not-negotiated)
        self.out = Gst.parse_launch(f"appsrc name=src is-live=true format=time caps={caps} ! videoconvert"
                                    f" ! video/x-raw,format=YUY2 ! v4l2sink device={device} sync=false")
        self.src = self.out.get_by_name("src")
        self.out.set_state(Gst.State.PLAYING)
        self.frame = 0
        GLib.timeout_add(1000 // FPS, self.push)

    def push(self):
        fresh = self.latest is not None and time.monotonic() - self.latest_at < 1.0
        buf = (self.latest if fresh else self.black).copy()
        buf.pts = self.frame * Gst.SECOND // FPS
        buf.duration = Gst.SECOND // FPS
        self.frame += 1
        self.src.emit("push-buffer", buf)
        return True

    @property
    def on(self):
        return self.proc is not None

    def start(self):
        # the stream says it is video (props and caps): as "Stream/Input/Unknown" WirePlumber's linking did not find the
        # camera ("target not found") once it had been restarted. The pid is kept to end it for sure at stop.
        self.serial = getattr(self, "serial", 0) + 1
        self.pidfile = (f"$XDG_RUNTIME_DIR/surface-av-camera.{os.getpid()}.{os.path.basename(self.device)}"
                        f".{self.serial}.pid")   # one per start
        # 8 Mbit/s at the encoder's best quality (target-usage 1): at 4 Mbit/s the sensor's grain in a dim room turned
        # into blocks; the Surface's graphics chip does it, and the network is the home's (or Tailscale's)
        remote = (f"echo $$ > {self.pidfile}; exec gst-launch-1.0 -q pipewiresrc target-object={self.target}"
                  " stream-properties=props,media.type=Video,media.category=Capture,media.role=Camera do-timestamp=true"
                  " ! video/x-raw ! watchdog timeout=3000"
                  f" ! vapostproc ! 'video/x-raw(memory:VAMemory),format=NV12,width={W},height={H}'"
                  " ! vah264enc rate-control=cbr bitrate=8000 target-usage=1 key-int-max=30 ! h264parse config-interval=-1 ! mpegtsmux"
                  " ! fdsink fd=1")
        self.proc = subprocess.Popen(SSH + [remote], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.pipe = Gst.parse_launch(
            f"fdsrc fd={self.proc.stdout.fileno()} ! tsdemux ! h264parse ! vah264dec ! videoconvert ! videoscale"
            f" ! video/x-raw,format=YUY2,width={W},height={H}"
            " ! appsink name=sink emit-signals=true max-buffers=1 drop=true sync=false")
        self.pipe.get_by_name("sink").connect("new-sample", self.sample)
        self.pipe.set_state(Gst.State.PLAYING)
        self.started = time.monotonic()
        log(f"{self.name} on")

    def sample(self, sink):
        s = sink.emit("pull-sample")
        if s:
            self.latest = s.get_buffer()
            self.latest_at = time.monotonic()
        return Gst.FlowReturn.OK

    def stop(self, wait=False):
        """Taken down on a thread (ssh to the Surface can take seconds, and the frames to the virtual camera must go
        on); wait=True at the end of the session."""
        pipe, proc, self.pipe, self.proc = self.pipe, self.proc, None, None
        pidfile = getattr(self, "pidfile", None)
        self.latest = None
        if not pipe and not proc:
            return

        def down():
            if pipe:
                pipe.set_state(Gst.State.NULL)
            if proc:
                proc.terminate()
                try:
                    proc.wait(5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                # the Surface's end, in case it outlived its ssh session (it would keep the camera, and its light, on)
                if pidfile:
                    run(*SSH, f'f={pidfile}; [ -s "$f" ] && kill "$(cat "$f")" 2>/dev/null; rm -f "$f"')
            log(f"{self.name} off")

        t = threading.Thread(target=down, daemon=True)
        t.start()
        if wait:
            t.join(15)

    def stalled(self):
        """On, and no frame for 10 s (the camera taken by another app on the Surface, the network): to be started again."""
        return self.on and (self.proc.poll() is not None or time.monotonic() - max(self.latest_at, self.started) > 10)

    def close(self):
        self.stop(wait=True)
        self.out.set_state(Gst.State.NULL)


class Microphone:
    """The tunnel itself is "Surface Microphone", for the whole session. With nobody recording it is suspended and its
    stream on the Surface corked, so the Surface's microphone is not used (tried: SUSPENDED here, corked there)."""

    def __init__(self):
        self.module = None
        self.addr = None
        self.tried = 0.0

    @property
    def on(self):
        return self.module is not None

    def present(self):
        return any(line.split("\t")[1:2] == [MIC] for line in run("pactl", "list", "short", "sources").stdout.splitlines())

    def start(self):
        self.tried = time.monotonic()
        status = json.loads(run("tailscale", "status", "--json").stdout or "{}")
        surface = next((p["TailscaleIPs"][0] for p in (status.get("Peer") or {}).values()
                        if p.get("HostName", "").lower() == "surface"), None)
        pc = (run("tailscale", "ip", "-4").stdout.split() or [None])[0]
        if not surface or not pc:
            log("microphone: Tailscale does not see the Surface")
            return
        remote = run(*SSH, f"pactl list short modules | awk '/module-native-protocol-tcp/ && /port={PORT}/ {{print $1}}'"
                     " | xargs -r -n1 pactl unload-module;"
                     f" pactl load-module module-native-protocol-tcp listen={surface} port={PORT} auth-ip-acl={pc}"
                     " auth-anonymous=false >/dev/null; pactl get-default-source").stdout.split()
        if not remote:
            log("microphone: the Surface did not answer")
            return
        self.addr = surface
        res = run("pactl", "load-module", "module-tunnel-source", f"server=tcp:{surface}:{PORT}", f"source={remote[-1]}",
                  f"source_name={MIC}", "channels=1", "rate=48000", "format=s16le",
                  "source_properties=device.description=\"Surface\\ Microphone\"")
        self.module = res.stdout.strip() or None
        log("microphone ready" if self.module else "microphone: tunnel failed")

    def check(self):
        """Again when the tunnel went (the Surface asleep, the network), at most every 30 s."""
        if self.on and not self.present():
            log("microphone: tunnel gone")
            self.stop()
        if not self.on and time.monotonic() - self.tried > 30:
            self.start()

    def stop(self):
        if self.module:
            run("pactl", "unload-module", self.module)
            self.module = None
        if self.addr:
            # the Surface's listener goes, found by its port (no pkill there: its pattern would match its own shell)
            run(*SSH, f"pactl list short modules | awk '/module-native-protocol-tcp/ && /port={PORT}/ {{print $1}}'"
                " | xargs -r -n1 pactl unload-module")
            self.addr = None

    def close(self):
        self.stop()


def main():
    Gst.init(None)
    cameras = [Camera(d, target) for d, target in loopback_devices()]
    if cameras:
        # the writer settles (first frames pushed by the main loop, which is not running yet: a short loop of its own)
        ctx = GLib.MainContext.default()
        end = time.monotonic() + 1.5
        while time.monotonic() < end:
            ctx.iteration(False)
            time.sleep(0.01)
    openers = {c: Openers(c.device) for c in cameras}
    mic = Microphone()
    stopping = threading.Event()

    def mic_loop():
        # ssh and pactl on their own thread: the main loop feeds the virtual camera
        mic.start()
        while not stopping.wait(5):
            mic.check()

    mic_thread = threading.Thread(target=mic_loop, daemon=True)
    mic_thread.start()
    log("ready (cameras: %s)" % (", ".join(f"{c.name} {c.device}" for c in cameras) or "none, no v4l2loopback"))
    since = {}

    def held(key, want, now):
        """Seconds the wish has held (want or not), counted from its last change."""
        if since.get(key) != want:
            since[key] = want
            since[key + "@"] = now
        return now - since[key + "@"]

    def tick():
        now = time.monotonic()
        for camera in cameras:
            want = openers[camera].poll() > 0
            t = held(camera.device, want, now)
            if want and not camera.on and t >= 1.0:           # apps probing a device open and close it at once
                camera.start()
            elif not want and camera.on and t >= 5.0:
                camera.stop()
            elif camera.stalled():
                log(f"{camera.name}: no frames, starting again")
                camera.stop()
                camera.start()
        return True

    loop = GLib.MainLoop()
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal_add(GLib.PRIORITY_HIGH, sig, lambda *_: (loop.quit(), False)[1])
    GLib.timeout_add(1000, tick)
    try:
        loop.run()
    finally:
        stopping.set()
        for camera in cameras:
            camera.close()
        mic_thread.join(10)
        mic.close()
        log("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
