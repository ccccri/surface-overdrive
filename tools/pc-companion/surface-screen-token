#!/bin/bash
# surface-screen-token: Sunshine's portal restore token kept in step with the permission the user gave.
#
# Sunshine (Flatpak, portal capture) restores the screen and input permission with a token kept in portal_token. The portal
# replaces a token when it is used, and a stream that hung (seen 2026-11-10: the capture session never answered, Sunshine
# killed itself after 10 s) can take the new one with it: the file keeps the old token, the portal no longer knows it, and
# KDE asks again ("Allow Sunshine to gain remote control privileges?") with Sunshine waiting on it, so streams fail until
# someone at the PC answers. The permission itself is still there, under the new token: when the file's token is not among
# the portal's grants for Sunshine and there is one, it is written into the file. Nothing is granted here.
# Run before Sunshine starts (ExecStartPre) and before every stream (surface-screen-stop, the global prep).
FILE=$HOME/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine/portal_token
[ -f "$FILE" ] || exit 0
mapfile -t grants < <(flatpak permission-show dev.lizardbyte.app.Sunshine 2>/dev/null |
    awk -F'\t' '$1 == "remote-desktop" && $3 == "dev.lizardbyte.app.Sunshine" && $4 == "yes" {print $2}')
[ ${#grants[@]} -gt 0 ] || exit 0
current=$(cat "$FILE")
for g in "${grants[@]}"; do [ "$g" = "$current" ] && exit 0; done
# the newest grant is the last one listed
printf '%s' "${grants[-1]}" > "$FILE.tmp" && mv "$FILE.tmp" "$FILE"
echo "$(date +%T) portal token: ${current:0:6}... no longer granted, using ${grants[-1]:0:6}..." >> "${XDG_RUNTIME_DIR:-/tmp}/surface-screen.log"
exit 0
