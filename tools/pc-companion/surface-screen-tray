#!/bin/bash
# surface-screen-tray hide|show: the system tray's icons that a stream to the Surface turns on and that say nothing then,
# moved to the tray's hidden items for the session and back after.
#   plasmashell_microphone: Sunshine records the PC's sound (sink-sunshine-*.monitor) to send it to the Surface, and Plasma
#     counts every recording stream with a program behind it as the microphone in use.
#   xdg-desktop-portal-kde: "Remote Control", the portal session Sunshine holds for the screen and input.
# Only these two ids are added or removed; the rest of hiddenItems is the user's.
set -u
case ${1:-} in hide) op=add ;; show) op=remove ;; *) echo "usage: surface-screen-tray hide|show" >&2; exit 2 ;; esac
script="var ids = ['plasmashell_microphone', 'xdg-desktop-portal-kde'];
var ps = panels();
for (var i = 0; i < ps.length; i++) {
  var ws = ps[i].widgets('org.kde.plasma.systemtray');
  for (var j = 0; j < ws.length; j++) {
    var w = ws[j];
    w.currentConfigGroup = ['General'];
    var cur = w.readConfig('hiddenItems', []);
    if (typeof cur === 'string') cur = cur ? cur.split(',') : [];
    var out = [];
    for (var k = 0; k < cur.length; k++) if (ids.indexOf(cur[k]) < 0) out.push(cur[k]);
    if ('$op' === 'add') out = out.concat(ids);
    w.writeConfig('hiddenItems', out);
    w.reloadConfig();
  }
}"
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$script" >/dev/null 2>&1 ||
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s "$script" >/dev/null 2>&1
exit 0
