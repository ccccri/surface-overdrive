# Lets the logged-in user raise the update rate of the accelerometer and gyroscope (default 10 Hz) while the Sensors page shows live values.
ACTION=="add", SUBSYSTEM=="iio", ATTR{name}=="accel_3d|gyro_3d", RUN+="/bin/sh -c 'chmod 0664 /sys%p/in_*_sampling_frequency; chgrp wheel /sys%p/in_*_sampling_frequency'"
