{
  "policies": {
    "NoDefaultBookmarks": true,
    "Bookmarks": [
      {
        "Title": "Surface Overdrive",
        "URL": "https://github.com/ccccri/surface-overdrive",
        "Placement": "toolbar"
      }
    ],
    "Preferences": {
      "browser.startup.homepage": {
        "Value": "about:home",
        "Status": "default"
      },
      "browser.newtabpage.pinned": {
        "Value": "[]",
        "Status": "default"
      }
    },
    "Permissions": {
      "Microphone": {
        "Allow": [
          "https://www.google.com"
        ]
      }
    },
    "ExtensionSettings": {
      "voice-search@surfaceoverdrive.org": {
        "private_browsing": true
      }
    }
  }
}
