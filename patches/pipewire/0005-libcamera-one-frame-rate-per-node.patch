@@ -578,6 +580,19 @@ static uint32_t camera_max_fps(struct impl *impl)
 	return 1;
 }
 
+/*
+ * The same rate for the whole life of the node: the camera's frame duration limits follow the sensor mode of its last
+ * configuration (the Surface Go's rear camera reports 15 fps before its first stream and 30 after one at 1536x1152).
+ * Applications that remember the formats they were offered then ask for a rate no longer offered: Chromium opened the
+ * rear camera once, and the second time got "no more input formats".
+ */
+static uint32_t camera_max_fps(struct impl *impl)
+{
+	if (impl->offered_fps == 0)
+		impl->offered_fps = camera_max_fps_now(impl);
+	return impl->offered_fps;
+}
