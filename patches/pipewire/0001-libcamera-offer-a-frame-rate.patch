+/*
+ * The highest frame rate of the camera, from the shortest frame duration it reports (in microseconds), or 30 when it
+ * reports none. Every format is offered with a frame rate range up to it: without one, GStreamer applications fix the
+ * frame rate of the stream to the smallest fraction they can, and an encoder then writes a frame every 2^31 seconds
+ * (Kamoso recorded 6 frames in 18 seconds).
+ */
+static uint32_t camera_max_fps(struct impl *impl)
+{
+	const ControlInfoMap &info = impl->camera->controls();
+	auto it = info.find(&controls::FrameDurationLimits);
+	if (it == info.end())
+		return 30;
+	const int64_t shortest = it->second.min().get<int64_t>();
+	if (shortest <= 0)
+		return 30;
+	/* The usual rate at or just below it: a sensor capped at 30 fps reports 31.9 (a 31.35 ms frame). */
+	const double fps = 1000000.0 / shortest;
+	for (uint32_t usual : { 240u, 120u, 60u, 50u, 30u, 25u, 24u, 20u, 15u, 10u, 5u })
+		if (fps >= usual - 0.5)
+			return usual;
+	return 1;
+}
