diff --git a/include/libcamera/internal/camera_memory.h b/include/libcamera/internal/camera_memory.h
new file mode 100644
index 0000000..a16dab1
--- /dev/null
+++ b/include/libcamera/internal/camera_memory.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * What a camera settled on, kept across restarts of the system (Surface Overdrive)
+ *
+ * Header-only. The exposure and the white balance a session ends with are the best guess for the next one: the light
+ * where the tablet is used rarely changes between two uses. Within a process the algorithms remember them on their own;
+ * this keeps them across a reboot too, so that the first picture after one starts right instead of green and dark.
+ *
+ * <dir>/<sensor model>.<name>, one line of numbers. <dir> is $XDG_STATE_HOME/surface-overdrive/camera, else
+ * $HOME/.local/state/surface-overdrive/camera. Written to a temporary file and renamed, so a reader never sees half a file.
+ */
+
+#pragma once
+
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include <stdio.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace libcamera {
+
+namespace CameraMemory {
+
+inline std::string dir()
+{
+	const char *x = getenv("XDG_STATE_HOME");
+	const char *h = getenv("HOME");
+	if (x && *x)
+		return std::string(x) + "/surface-overdrive/camera";
+	if (h && *h)
+		return std::string(h) + "/.local/state/surface-overdrive/camera";
+	return {};
+}
+
+/* The numbers stored under name, empty when there are none (or they are not finite). */
+inline std::vector<double> load(const std::string &model, const std::string &name)
+{
+	const std::string d = dir();
+	std::vector<double> values;
+	if (d.empty())
+		return values;
+	std::ifstream f(d + "/" + model + "." + name);
+	double v;
+	while (f >> v) {
+		if (!std::isfinite(v))
+			return {};
+		values.push_back(v);
+	}
+	return values;
+}
+
+inline void save(const std::string &model, const std::string &name, const std::vector<double> &values)
+{
+	const std::string d = dir();
+	if (d.empty())
+		return;
+	/* Make the directory and its parents (mode 0700, as the state of one user). */
+	for (size_t i = 1; i <= d.size(); i++)
+		if (i == d.size() || d[i] == '/')
+			mkdir(d.substr(0, i).c_str(), 0700);
+	const std::string path = d + "/" + model + "." + name;
+	const std::string tmp = path + ".tmp" + std::to_string(getpid());
+	{
+		std::ofstream f(tmp);
+		for (size_t i = 0; i < values.size(); i++)
+			f << (i ? " " : "") << values[i];
+		f << "\n";
+		if (!f)
+			return;
+	}
+	rename(tmp.c_str(), path.c_str());
+}
+
+} /* namespace CameraMemory */
+
+} /* namespace libcamera */
