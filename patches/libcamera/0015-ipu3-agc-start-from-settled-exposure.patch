@@ -37,6 +37,8 @@ namespace ipa::ipu3::algorithms {
  * back from a completely blown out image. Keep the initial exposure and gain for this many frames.
  */
 static constexpr uint32_t kAgcSkipFrames = 8;
+/* Frames after which the exposure of a session counts as settled and is remembered for the next one (about a second at 30 fps). */
+static constexpr uint32_t kAgcSettledFrames = kAgcSkipFrames + 22;
 
 /**
  * \class Agc
@@ -121,6 +123,13 @@ int Agc::configure(IPAContext &context,
 	activeState.agc.gain = minAnalogueGain_;
 	activeState.agc.exposure = 10ms / configuration.sensor.lineDuration;
 
+	/* Start from what the previous session settled on, within the limits of this sensor mode. */
+	if (haveSettled_) {
+		activeState.agc.gain = std::clamp(settledAnalogueGain_, minAnalogueGain_, maxAnalogueGain_);
+		activeState.agc.exposure = std::clamp(settledExposureTime_, minExposureTime_, maxExposureTime_)
+					 / configuration.sensor.lineDuration;
+	}
+
 	context.activeState.agc.constraintMode = constraintModes().begin()->first;
 	context.activeState.agc.exposureMode = exposureModeHelpers().begin()->first;
 
@@ -272,6 +281,12 @@ void Agc::process(IPAContext &context, const uint32_t frame,
 	activeState.agc.exposure = newExposureTime / context.configuration.sensor.lineDuration;
 	activeState.agc.gain = aGain;
 
+	if (frame >= kAgcSettledFrames) {
+		haveSettled_ = true;
+		settledExposureTime_ = newExposureTime;
+		settledAnalogueGain_ = aGain;
+	}
+
 	metadata.set(controls::AnalogueGain, frameContext.sensor.gain);
 	metadata.set(controls::ExposureTime, exposureTime.get<std::micro>());
 
