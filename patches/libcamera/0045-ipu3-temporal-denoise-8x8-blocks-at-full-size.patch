+++ b/src/libcamera/pipeline/ipu3/ipu3.cpp
@@ -1699,14 +1699,22 @@ void tnrWeightsPlain(const int16_t *a, const int16_t *b, int16_t *w, unsigned in
 		w[x] = static_cast<int16_t>((a[x] * (256 - f) + b[x] * f + 128) >> 8);
 }
 
-/* Adds |cur - prev| of every group of 4 pixels of a row to sums[]. */
+/* Adds |cur - prev| of every group of 4 (or 8) pixels of a row to sums[]. */
