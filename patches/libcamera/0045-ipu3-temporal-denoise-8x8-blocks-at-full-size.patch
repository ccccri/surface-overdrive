+/* Block weights (0..256) of a block row to pixel weights (0..128), linear between block centres (4b + 1.5, 8b + 3.5). */
+void tnrExpand(const int *weights, unsigned int blocks, int16_t *w, unsigned int width, unsigned int block)
 {
+	if (block == 8) {
+		for (unsigned int b = 0; b < blocks; b++) {
+			const int l = weights[b ? b - 1 : b], m = weights[b], r = weights[b + 1 < blocks ? b + 1 : b];
+			int16_t *o = w + 8 * b;
+			o[0] = static_cast<int16_t>((l * 7 + m * 9 + 16) >> 5);
+			o[1] = static_cast<int16_t>((l * 5 + m * 11 + 16) >> 5);
+			o[2] = static_cast<int16_t>((l * 3 + m * 13 + 16) >> 5);
+			o[3] = static_cast<int16_t>((l + m * 15 + 16) >> 5);
+			o[4] = static_cast<int16_t>((r + m * 15 + 16) >> 5);
+			o[5] = static_cast<int16_t>((r * 3 + m * 13 + 16) >> 5);
+			o[6] = static_cast<int16_t>((r * 5 + m * 11 + 16) >> 5);
+			o[7] = static_cast<int16_t>((r * 7 + m * 9 + 16) >> 5);
+		}
+		for (unsigned int x = 8 * blocks; x < width; x++)
+			w[x] = w[8 * blocks - 1];
+		return;
+	}
 	for (unsigned int b = 0; b < blocks; b++) {
 		const int l = weights[b ? b - 1 : b], m = weights[b], r = weights[b + 1 < blocks ? b + 1 : b];
 		w[4 * b + 0] = static_cast<int16_t>((l * 3 + m * 5 + 8) >> 4);
