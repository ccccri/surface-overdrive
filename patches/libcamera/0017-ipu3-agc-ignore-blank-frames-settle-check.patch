 	Histogram hist = parseStatistics(stats, context.configuration.grid.bdsGrid);
+
+	/* Ignore blank frames: keep the current exposure and wait for a valid one. */
+	if (hist.interQuantileMean(0.0, 1.0) < kBlankMean) {
+		if (haveValidFrame_ || ++blankFrames_ <= kBlankGraceFrames)
+			return;
+	} else {
+		haveValidFrame_ = true;
+	}
+
 	rGain_ = context.activeState.awb.gains.red;
 	gGain_ = context.activeState.awb.gains.blue;
 	bGain_ = context.activeState.awb.gains.green;
@@ -281,7 +306,14 @@ void Agc::process(IPAContext &context, const uint32_t frame,
