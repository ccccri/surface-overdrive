  * back from a completely blown out image. Keep the initial exposure and gain for this many frames.
  */
 static constexpr uint32_t kAgcSkipFrames = 8;
-/* Frames after which the exposure of a session counts as settled and is remembered for the next one (about a second at 30 fps). */
-static constexpr uint32_t kAgcSettledFrames = kAgcSkipFrames + 22;
+/*
+ * An exposure counts as settled, and is remembered for the next session, once the exposure the algorithm asks for stays within
+ * kSettledTolerance of the one that was applied for kSettledFrames frames in a row.
+ */
+static constexpr double kSettledTolerance = 0.03;
+static constexpr uint32_t kSettledFrames = 10;
+/*
+ * A frame whose mean luminance is below this (in histogram bins) is treated as blank. The sensor delivers blank frames while it powers up and
+ * now and then at the start of a session; they say nothing about the scene and made the algorithm ask for an enormous gain, which then took
+ * seconds to decay.
+ */
+static constexpr double kBlankMean = 1.0;
+/* A scene that stays blank this long without ever having produced a valid frame is taken as really dark. */
+static constexpr uint32_t kBlankGraceFrames = 30;
 
