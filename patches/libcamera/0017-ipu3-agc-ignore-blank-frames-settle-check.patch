+	const utils::Duration requestedEv = newExposureTime * aGain;
+	if (std::abs(requestedEv / effectiveExposureValue - 1.0) < kSettledTolerance)
+		stableFrames_++;
+	else
+		stableFrames_ = 0;
+
+	if (stableFrames_ >= kSettledFrames) {
