+/**
+ * \brief Find the tracking information of a frame, if it is still tracked
+ * \param[in] id The frame number
+ *
+ * Messages from the IPA can arrive after the camera was stopped and its frames cleared. Unlike find(), a frame that is no longer
+ * tracked is not an error here: the caller ignores the message.
+ *
+ * \return The tracking information, or nullptr if the frame is not tracked any more
+ */
+IPU3Frames::Info *IPU3Frames::findIfPresent(unsigned int id)
+{
+	const auto &itInfo = frameInfo_.find(id);
+
+	if (itInfo != frameInfo_.end())
+		return &itInfo->second;
+
+	return nullptr;
+}
