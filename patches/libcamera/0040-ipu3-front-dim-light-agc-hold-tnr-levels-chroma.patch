+	heldAnalogueGain_ = 0.0;
+	heldResidual_ = 1.0;
 
 	/* Start from what the previous session settled on, within the limits of this sensor mode. */
 	/* The first session after a reboot starts from where the last one before it settled. */
@@ -369,6 +371,32 @@ void Agc::process(IPAContext &context, const uint32_t frame,
 		}
 	}
 
+	/*
+	 * Small changes are made with the digital gain, the exposure time and analogue gain stay. The analogue gain moves
+	 * in steps of 1/16 (6%): asked for 1.02, the sensor alternated between 1.0 and 1.0625, and in a dim room the
+	 * picture pulsed by 4% every few frames (129 -> 134 of luma for one frame in five, 2026-11-04), which also made
+	 * the temporal denoiser see the whole picture "moving" on those frames and let the grain through. Up to 8% (a
+	 * step and a bit) the ImgU's digital gain makes up the difference, smoothly and with no steps; the statistics are
+	 * taken before it, so the request stays the same and nothing hunts.
+	 */
+	{
+		constexpr double kHoldBand = 0.08;
+		const double wantedEv = newExposureTime.get<std::micro>() * aGain;
+		double residual = 1.0;
+		if (heldAnalogueGain_ > 0.0) {
+			const double heldEv = heldExposureTime_.get<std::micro>() * heldAnalogueGain_;
+			const double ratio = wantedEv / heldEv;
+			if (std::abs(ratio - 1.0) < kHoldBand) {
+				newExposureTime = heldExposureTime_;
+				aGain = heldAnalogueGain_;
+				residual = ratio;
+			}
+		}
+		heldExposureTime_ = newExposureTime;
+		heldAnalogueGain_ = aGain;
+		heldResidual_ = residual;
+	}
+
 	LOG(IPU3Agc, Debug)
 		<< "Divided up exposure time, analogue gain and digital gain are "
 		<< newExposureTime << ", " << aGain << " and " << dGain;
@@ -378,7 +406,7 @@ void Agc::process(IPAContext &context, const uint32_t frame,
 	activeState.agc.exposure = newExposureTime / context.configuration.sensor.lineDuration;
 	activeState.agc.gain = aGain;
 	/* smoothed, so that the picture does not pump when the auto exposure moves between exposure and digital gain */
-	const double wanted = std::clamp(dGain * qGain, 1.0, kMaxDigitalGain);
+	const double wanted = std::clamp(dGain * qGain * heldResidual_, 1.0, kMaxDigitalGain);
 	activeState.agc.digitalGain += (wanted - activeState.agc.digitalGain) * 0.25;
 	if (activeState.agc.vblank) {
 		/* the frame just long enough for the exposure, never shorter than a frame of 30 fps */
