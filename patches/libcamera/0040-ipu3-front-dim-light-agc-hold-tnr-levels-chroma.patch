-	const __m128i large = _mm_cmpgt_epi16(_mm_abs_epi16(d), passMinus1);
+	const __m128i a = _mm_abs_epi16(d);
+	const __m128i excess = _mm_max_epi16(_mm_sub_epi16(a, r.knee), _mm_setzero_si128());
+	const __m128i w = _mm_min_epi16(_mm_add_epi16(r.minWeight, _mm_mulhi_epu16(_mm_slli_epi16(excess, 8), r.slope)), r.full);
+	const __m128i average = _mm_add_epi16(p, tnrScale(d, tnrWeight8(w)));
+	const __m128i large = _mm_cmpgt_epi16(a, r.passMinus1);
 	return _mm_or_si128(_mm_and_si128(large, c), _mm_andnot_si128(large, average));
 }
 
