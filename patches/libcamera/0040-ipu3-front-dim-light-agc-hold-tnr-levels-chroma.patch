+/*
+ * One pixel of the temporal average: the remembered value p moves towards the current one c by a weight that depends on
+ * their difference. Small differences (noise) take the minimum weight, so the grain averages out; from a third of "pass"
+ * the weight rises evenly to the whole current value at "pass". The first version switched at "pass" in one step: a
+ * moving head or hand that changed the pixels by less than "pass" (about 30 levels in a dim room, where the noise is
+ * strong) counted as noise and stayed in the picture for many frames, the ghosting seen in low light. Now nothing
+ * clearly above the noise can linger: its weight is near 1.
+ */
+/* The motion test: thresholds in times the noise of the block's brightness, and judging blocks with their neighbours. */
+constexpr double kTnrFirst = 1.5;
+constexpr double kTnrSecond = 3.0;
+constexpr double kTnrPool = 1.0;
+
+static inline int tnrSoft(int c, int p, int minWeight, int pass)
+{
+	const int d = c - p, a = d < 0 ? -d : d;
+	if (a >= pass)
+		return c;
+	const int knee = pass / 3;
+	const int w = a <= knee ? minWeight : minWeight + (a - knee) * (128 - minWeight) / std::max(pass - knee, 1);
+	return p + ((d * w * 256 + 16384) >> 15);
+}
+
