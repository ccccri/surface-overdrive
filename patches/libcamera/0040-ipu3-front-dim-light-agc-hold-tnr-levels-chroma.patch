-TNR_TARGET inline __m128i tnrStill(__m128i c, __m128i p, __m128i minWeight8, __m128i passMinus1)
+/*
+ * The weight of the current frame for a difference d with the remembered picture: the minimum weight up to a third of
+ * "pass", rising evenly to all of the current frame at "pass" (see tnrSoft()).
+ */
+struct TnrRamp {
+	__m128i minWeight;	/* 1/128 */
+	__m128i knee;		/* pass / 3 */
+	__m128i slope;		/* (128 - minWeight) * 256 / (pass - knee), for _mm_mulhi_epu16 with the excess << 8 */
+	__m128i full;		/* 128 */
+	__m128i passMinus1;
+};
+
+TNR_TARGET inline TnrRamp tnrRamp(int minWeight, int pass)
+{
+	const int knee = pass / 3;
+	const int slope = std::min(((128 - minWeight) << 8) / std::max(pass - knee, 1), 32767);
+	return { _mm_set1_epi16(static_cast<int16_t>(minWeight)), _mm_set1_epi16(static_cast<int16_t>(knee)),
+		 _mm_set1_epi16(static_cast<int16_t>(slope)), _mm_set1_epi16(128),
+		 _mm_set1_epi16(static_cast<int16_t>(pass - 1)) };
+}
+
