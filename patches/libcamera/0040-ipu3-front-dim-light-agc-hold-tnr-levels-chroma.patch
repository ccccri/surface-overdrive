+/*
+ * Chroma noise reduction for dim light, luma-guided. In a dim room the noise of the front camera is mostly coloured
+ * blotches of 5 to 20 pixels (purple, green), which neither the ImgU's XNR3 (no visible change from alpha 32 down to 4)
+ * nor the temporal average of moving areas take away. The eye sees detail in the luma, not in the colour, so the
+ * colour is averaged over cells of 16x16 chroma pixels (32x32 of the picture), where the blotches cancel out, and
+ * brought back to full resolution between the 4 nearest cells, each weighted by how close its brightness is to the
+ * pixel's (the luma smoothed 5x5 first, or its own grain would bring the blotches back): colour does not bleed across
+ * the edges of things. Measured on a frame at gain 5.75 (2560x1920): chroma blotches 3.38 -> 0.91, skin, hair and wall
+ * keep their colours and edges. strength 0..256 blends it with the input. Rows and columns past the last whole
+ * quarter pixel (a size not a multiple of 4) are left as they are.
+ */
+__attribute__((optimize("O3"))) void chromaDenoise(const uint8_t *y, uint8_t *uv, unsigned int width,
+						     unsigned int height, unsigned int stride, int strength,
+						     std::vector<uint8_t> &scratch)
+{
+	/* Worked on a quarter grid (2x2 chroma pixels, 4x4 of the picture): colour that precise is more than the eye sees. */
+	constexpr unsigned int kCell = 8;	/* quarter pixels: 16x16 chroma, 32x32 picture */
+	constexpr float kSigma = 24.0f;
+	const unsigned int qw = width / 4, qh = height / 4;
+	if (qw < 2 * kCell || qh < 2 * kCell || strength <= 0)
+		return;
+	const unsigned int gw = (qw + kCell - 1) / kCell, gh = (qh + kCell - 1) / kCell;
+	const size_t qn = static_cast<size_t>(qw) * qh;
+
+	scratch.resize(qn * 4 + static_cast<size_t>(width) * 2 * sizeof(uint16_t));
+	uint8_t *lq = scratch.data(), *tmp = lq + qn, *uq = tmp + qn, *vq = uq + qn;
+	uint16_t *col = reinterpret_cast<uint16_t *>(vq + qn);
+
+	/* luma and chroma of every quarter pixel: means of 4x4 luma and 2x2 chroma (column sums first, vectorised) */
+	for (unsigned int r = 0; r < qh; r++) {
+		const uint8_t *l0 = y + static_cast<size_t>(4 * r) * stride, *l1 = l0 + stride, *l2 = l1 + stride;
+		const uint8_t *l3 = l2 + stride;
+		for (unsigned int x = 0; x < 4 * qw; x++)
+			col[x] = static_cast<uint16_t>(l0[x] + l1[x] + l2[x] + l3[x]);
+		uint8_t *dl = lq + static_cast<size_t>(r) * qw;
+		for (unsigned int x = 0; x < qw; x++)
+			dl[x] = static_cast<uint8_t>((col[4 * x] + col[4 * x + 1] + col[4 * x + 2] + col[4 * x + 3] + 8) >> 4);
+		const uint8_t *c0 = uv + static_cast<size_t>(2 * r) * stride, *c1 = c0 + stride;
+		for (unsigned int x = 0; x < 4 * qw; x++)
+			col[x] = static_cast<uint16_t>(c0[x] + c1[x]);
+		uint8_t *du = uq + static_cast<size_t>(r) * qw, *dv = vq + static_cast<size_t>(r) * qw;
+		for (unsigned int x = 0; x < qw; x++) {
+			du[x] = static_cast<uint8_t>((col[4 * x] + col[4 * x + 2] + 2) >> 2);
+			dv[x] = static_cast<uint8_t>((col[4 * x + 1] + col[4 * x + 3] + 2) >> 2);
+		}
+	}
+	/* the luma smoothed once more, 3x3, or its grain would bring the blotches back through the weights */
+	for (unsigned int r = 0; r < qh; r++) {
+		const uint8_t *src = lq + static_cast<size_t>(r) * qw;
+		uint8_t *d = tmp + static_cast<size_t>(r) * qw;
+		d[0] = static_cast<uint8_t>((2 * src[0] + src[1] + 1) / 3);
+		for (unsigned int x = 1; x + 1 < qw; x++)
+			d[x] = static_cast<uint8_t>((src[x - 1] + src[x] + src[x + 1]) * 21846 >> 16);
+		d[qw - 1] = static_cast<uint8_t>((src[qw - 2] + 2 * src[qw - 1] + 1) / 3);
+	}
+	for (unsigned int r = 0; r < qh; r++) {
+		const uint8_t *up = tmp + static_cast<size_t>(r ? r - 1 : 0) * qw;
+		const uint8_t *mid = tmp + static_cast<size_t>(r) * qw;
+		const uint8_t *down = tmp + static_cast<size_t>(std::min(r + 1, qh - 1)) * qw;
+		uint8_t *d = lq + static_cast<size_t>(r) * qw;
+		for (unsigned int x = 0; x < qw; x++)
+			d[x] = static_cast<uint8_t>((up[x] + mid[x] + down[x]) * 21846 >> 16);
+	}
+
+	/* cell means (U and V in 1/16) */
+	const size_t cells = static_cast<size_t>(gw) * gh;
+	std::vector<unsigned int> sy(cells), su(cells), sv(cells), count(cells);
+	for (unsigned int r = 0; r < qh; r++) {
+		const size_t row = static_cast<size_t>(r / kCell) * gw;
+		const uint8_t *l = lq + static_cast<size_t>(r) * qw, *u = uq + static_cast<size_t>(r) * qw;
+		const uint8_t *v = vq + static_cast<size_t>(r) * qw;
+		for (unsigned int cx = 0, x = 0; cx < gw; cx++) {
+			const unsigned int end = std::min(x + kCell, qw);
+			unsigned int a = 0, bu = 0, bv = 0;
+			for (unsigned int k = x; k < end; k++) {
+				a += l[k];
+				bu += u[k];
+				bv += v[k];
+			}
+			sy[row + cx] += a;
+			su[row + cx] += bu;
+			sv[row + cx] += bv;
+			count[row + cx] += end - x;
+			x = end;
+		}
+	}
+	std::vector<int> cy(cells), cu(cells), cv(cells);
+	for (size_t i = 0; i < cells; i++) {
+		const unsigned int n = std::max(count[i], 1U);
+		cy[i] = static_cast<int>((sy[i] + n / 2) / n);
+		cu[i] = static_cast<int>((su[i] * 16 + n / 2) / n);
+		cv[i] = static_cast<int>((sv[i] * 16 + n / 2) / n);
+	}
+
+	/* the brightness weight exp(-(d / sigma)^2) in 1/256, at least 1 */
+	std::array<uint32_t, 256> range;
+	for (int d = 0; d < 256; d++)
+		range[d] = std::max<uint32_t>(1, static_cast<uint32_t>(std::lround(256 * std::exp(-(d / kSigma) * (d / kSigma)))));
+	/* cell positions: (x + 0.5) / 8 - 0.5 falls on sixteenths exactly */
+	std::vector<unsigned int> x0(qw), fx(qw);
+	for (unsigned int x = 0; x < qw; x++) {
+		const int f16 = std::clamp(static_cast<int>(2 * x) + 1 - static_cast<int>(kCell), 0,
+					   static_cast<int>(16 * (gw - 1)));
+		x0[x] = static_cast<unsigned int>(f16) / 16;
+		fx[x] = static_cast<unsigned int>(f16) % 16;
+	}
+
+	/* each quarter pixel: the 4 nearest cells, by distance and by brightness; written to its 2x2 chroma pixels */
+	const int blend = strength;
+	for (unsigned int r = 0; r < qh; r++) {
