+/*
+ * Complete as cancelled every request still tracked by the frame bookkeeping: buffers the pipeline still owns are cancelled
+ * and given back to the request, then the request is completed.
+ */
+void IPU3CameraData::cancelTrackedRequests()
+{
+	for (Request *request : frameInfos_.trackedRequests()) {
+		for (const auto &[stream, buffer] : request->buffers()) {
+			/* A buffer that already went through completeBuffer() is no longer attached to its request. */
+			if (!buffer->request())
+				continue;
+
+			buffer->_d()->cancel();
+			pipe()->completeBuffer(request, buffer);
+		}
+
+		pipe()->completeRequest(request);
+	}
+}
