+/**
+ * \brief Get the requests of all frames that are still tracked
+ *
+ * A frame is tracked from the moment its request is queued until the request is completed, so these are the requests that
+ * are in flight inside the pipeline.
+ *
+ * \return The requests of the tracked frames
+ */
+std::vector<Request *> IPU3Frames::trackedRequests() const
+{
+	std::vector<Request *> requests;
+
+	for (const auto &[id, info] : frameInfo_)
+		requests.push_back(info.request);
+
+	return requests;
+}
