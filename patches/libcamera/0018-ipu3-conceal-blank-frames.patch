+/*
+ * Now and then the ImgU hands back a frame that is entirely black (luma 0, neutral chroma): it processed a raw frame that held no
+ * light, which shows as a flash. Show the previous good frame again instead, which nobody notices. Returns true when the frame was
+ * replaced; with no previous good frame there is nothing to show and the frame is left alone.
+ */
+bool IPU3CameraData::concealBlankFrame(const Stream *stream, FrameBuffer *buffer)
+{
+	const StreamConfiguration &cfg = stream->configuration();
+	if (cfg.pixelFormat != formats::NV12)
+		return false;
+
+	auto last = lastGoodFrame_.find(stream);
+	if (last == lastGoodFrame_.end())
+		return false;
+
+	MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::ReadWrite);
+	if (!mapped.isValid() || mapped.planes().size() < 2)
+		return false;
+
+	const size_t ySize = static_cast<size_t>(cfg.stride) * cfg.size.height;
+	const size_t uvSize = ySize / 2;
+	uint8_t *y = mapped.planes()[0].data();
+	uint8_t *uv = mapped.planes()[1].data();
+	if (mapped.planes()[0].size() < ySize || mapped.planes()[1].size() < uvSize ||
+	    last->second.size() != ySize + uvSize)
+		return false;
+
+	/* Blank: every sampled luma byte is zero. */
+	for (size_t i = 0; i < ySize; i += 97)
+		if (y[i])
+			return false;
+
+	std::copy(last->second.begin(), last->second.begin() + ySize, y);
+	std::copy(last->second.begin() + ySize, last->second.end(), uv);
+	LOG(IPU3, Debug) << "Blank frame replaced by the previous one";
+
+	return true;
+}
+
+/* Keep a copy of the finished frame for concealBlankFrame(). */
+void IPU3CameraData::rememberFrame(const Stream *stream, FrameBuffer *buffer)
+{
+	const StreamConfiguration &cfg = stream->configuration();
+	if (cfg.pixelFormat != formats::NV12)
+		return;
+
+	MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
+	if (!mapped.isValid() || mapped.planes().size() < 2)
+		return;
+
+	const size_t ySize = static_cast<size_t>(cfg.stride) * cfg.size.height;
+	const size_t uvSize = ySize / 2;
+	if (mapped.planes()[0].size() < ySize || mapped.planes()[1].size() < uvSize)
+		return;
+
+	/* A blank frame must not become the reference. */
+	const uint8_t *y = mapped.planes()[0].data();
+	bool blank = true;
+	for (size_t i = 0; i < ySize && blank; i += 97)
+		blank = y[i] == 0;
+	if (blank)
+		return;
+
+	std::vector<uint8_t> &frame = lastGoodFrame_[stream];
+	frame.resize(ySize + uvSize);
+	std::copy(y, y + ySize, frame.begin());
+	std::copy(mapped.planes()[1].data(), mapped.planes()[1].data() + uvSize, frame.begin() + ySize);
+}
