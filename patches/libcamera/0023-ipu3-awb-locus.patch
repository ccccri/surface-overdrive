+/*
+ * Move a white point (natural logs of R/G and B/G) onto the locus: to the nearest point of the polyline (the end segments
+ * extended by locusExtend_), then back off it by what is left of the distance within the band allowed on that side. The
+ * green side is the one where both ratios are lower, i.e. green stronger.
+ */
+std::pair<double, double> Awb::constrainToLocus(double x, double y) const
+{
+	double bestDist = std::numeric_limits<double>::max();
+	double bx = x, by = y, nx = 0.0, ny = 0.0, side = 0.0;
+
+	for (size_t i = 0; i + 1 < locus_.size(); i++) {
+		const double ax = locus_[i].first, ay = locus_[i].second;
+		const double dx = locus_[i + 1].first - ax, dy = locus_[i + 1].second - ay;
+		const double len = std::hypot(dx, dy);
+		if (len <= 0.0)
+			continue;
+		const double ux = dx / len, uy = dy / len;
+		double t = (x - ax) * ux + (y - ay) * uy;
+		const double lo = i == 0 ? -locusExtend_ : 0.0;
+		const double hi = i + 2 == locus_.size() ? len + locusExtend_ : len;
+		t = std::clamp(t, lo, hi);
+		const double px = ax + ux * t, py = ay + uy * t;
+		const double dist = std::hypot(x - px, y - py);
+		if (dist < bestDist) {
+			bestDist = dist;
+			bx = px;
+			by = py;
+			/* Unit normal pointing to the green side (both coordinates lower). */
+			nx = -uy;
+			ny = ux;
+			if (nx + ny > 0) {
+				nx = -nx;
+				ny = -ny;
+			}
+			side = (x - px) * nx + (y - py) * ny;
+		}
+	}
+
+	const double offset = std::clamp(side, -locusMagenta_, locusGreen_);
+	return { bx + nx * offset, by + ny * offset };
+}
