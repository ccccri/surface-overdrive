+				state.agc.gain *= 2;
+			} else {
+				const utils::Duration doubled = state.agc.exposure * context.configuration.sensor.lineDuration * 2;
+				state.agc.exposure = std::min(doubled, maxExposureTime_) / context.configuration.sensor.lineDuration;
+			}
+		}
+		return;
 	}
+	haveValidFrame_ = true;
 
 	rGain_ = context.activeState.awb.gains.red;
 	gGain_ = context.activeState.awb.gains.blue;
