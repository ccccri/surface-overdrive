@@ -252,13 +249,24 @@ void Agc::process(IPAContext &context, const uint32_t frame,
 
 	Histogram hist = parseStatistics(stats, context.configuration.grid.bdsGrid);
 
-	/* Ignore blank frames: keep the current exposure and wait for a valid one. */
+	/*
+	 * A blank frame says nothing about the scene. Once the session has produced a valid frame, stray blank ones are ignored. Before
+	 * that the sensor is still powering up or the scene is dark: climb towards more light one step at a time (twice the exposure value
