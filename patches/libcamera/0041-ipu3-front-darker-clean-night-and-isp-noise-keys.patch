--- a/src/ipa/ipu3/algorithms/noise_reduction.h
+++ b/src/ipa/ipu3/algorithms/noise_reduction.h
@@ -56,6 +56,9 @@ private:
 	/* Whether the last frame set XNR3 or CHNR: the kernel keeps the last values it got until it is told otherwise. */
 	bool xnr3Set_ = false;
 	bool chnrSet_ = false;
+	bool anrSet_ = false;
+	bool yeeSet_ = false;
+	bool iefdSet_ = false;
 	bool binned_ = false;
 	std::unique_ptr<LiveProfile> profile_;
 };
