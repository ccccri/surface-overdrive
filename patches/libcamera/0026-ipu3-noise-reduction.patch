+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * IPU3 spatial noise reduction: XNR3 and the chroma noise reduction (CHNR) of the ImgU
+ */
+
+#pragma once
+
+#include <array>
+#include <memory>
+
+#include "libcamera/internal/live_profile.h"
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::ipu3::algorithms {
+
+class NoiseReduction : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void prepare(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     ipu3_uapi_params *params) override;
+
+private:
+	static constexpr unsigned int kXnr3Size = 11;
+	static constexpr unsigned int kChnrSize = 12;
+
+	/* XNR3: alpha y0 u0 v0 ydiff udiff vdiff, coring u0 v0 udiff vdiff, blending strength. */
+	std::array<double, kXnr3Size> xnr3_{};
+	std::array<double, kXnr3Size> xnr3Binned_{};
+	bool hasXnr3_ = false;
+	bool hasXnr3Binned_ = false;
+	/* CHNR: coring u v, sense gains vy vu vv hy hu hv, FIR taps 0 1 2, IIR weight. */
+	std::array<double, kChnrSize> chnr_{};
+	bool hasChnr_ = false;
+	/* Whether the last frame set XNR3 or CHNR: the kernel keeps the last values it got until it is told otherwise. */
+	bool xnr3Set_ = false;
+	bool chnrSet_ = false;
+	bool binned_ = false;
+	std::unique_ptr<LiveProfile> profile_;
+};
+
+} /* namespace ipa::ipu3::algorithms */
+
+} /* namespace libcamera */
