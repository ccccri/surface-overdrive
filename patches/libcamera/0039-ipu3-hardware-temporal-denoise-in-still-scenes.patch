 private:
 	static constexpr unsigned int kXnr3Size = 11;
 	static constexpr unsigned int kChnrSize = 12;
+	static constexpr unsigned int kTnr3Size = 7;
 
 	/* XNR3: alpha y0 u0 v0 ydiff udiff vdiff, coring u0 v0 udiff vdiff, blending strength. */
 	std::array<double, kXnr3Size> xnr3_{};
@@ -37,6 +43,16 @@
 	/* CHNR: coring u v, sense gains vy vu vv hy hu hv, FIR taps 0 1 2, IIR weight. */
 	std::array<double, kChnrSize> chnr_{};
 	bool hasChnr_ = false;
+	/* TNR3: max feedback Y, max feedback UV, knee Y1, knee Y2, sigma, slope, rounding; in good light and in the dark. */
+	std::array<double, kTnr3Size> tnr3_{};
+	std::array<double, kTnr3Size> tnr3Dark_{};
+	bool hasTnr3_ = false;
+	bool hasTnr3Dark_ = false;
+	bool tnr3Set_ = false;
+	/* how much of the TNR3 feedback the scene allows: 0 while it moves, back to 1 once it is still (see process()) */
+	double tnr3Still_ = 0.0;
+	unsigned int stillFrames_ = 0;
+	std::vector<uint32_t> prevCells_;
 	/* Whether the last frame set XNR3 or CHNR: the kernel keeps the last values it got until it is told otherwise. */
 	bool xnr3Set_ = false;
 	bool chnrSet_ = false;
