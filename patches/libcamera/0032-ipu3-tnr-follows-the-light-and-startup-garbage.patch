+/*
+ * The first frames the ImgU puts out after it was last used at another size can be garbage: magenta, in horizontal stripes
+ * (luma and chroma alike), seen as purple flashes when an application changed the resolution. Measured on the Surface Go:
+ * the first frame of the front camera at 1152x864 after a session at 2560x1920 had chroma at 224/224 (neutral is 128), the
+ * next one was fine but the temporal denoiser, seeded with the garbage, carried it into two more. The first frames of a
+ * session are checked; one whose chroma is far from neutral in both U and V the same way (magenta or green over the whole
+ * picture, which no real scene is) is marked as an error, so that it is neither shown (the PipeWire plugin skips it) nor
+ * used as the reference of the denoiser or of concealBlankFrame().
+ */
+bool IPU3CameraData::startupGarbage(const Stream *stream, FrameBuffer *buffer)
+{
+	auto check = startupChecks_.try_emplace(stream, 3).first;
+	if (check->second == 0)
+		return false;
+	check->second--;
+
+	const StreamConfiguration &cfg = stream->configuration();
+	if (cfg.pixelFormat != formats::NV12)
+		return false;
+	MappedFrameBuffer mapped(buffer, MappedFrameBuffer::MapFlag::Read);
+	if (!mapped.isValid() || mapped.planes().size() < 2)
+		return false;
+	const size_t uvSize = static_cast<size_t>(cfg.stride) * cfg.size.height / 2;
+	if (mapped.planes()[1].size() < uvSize)
+		return false;
+
+	/* blank (the second frame of a session often is): not a reference for the denoiser, which would fade in from black */
+	const size_t ySize = static_cast<size_t>(cfg.stride) * cfg.size.height;
+	if (mapped.planes()[0].size() >= ySize) {
+		const uint8_t *y = mapped.planes()[0].data();
+		bool blank = true;
+		for (size_t i = 0; i < ySize && blank; i += 97)
+			blank = y[i] <= kBlankLuma;
+		if (blank) {
+			LOG(IPU3, Debug) << "Start-up blank frame dropped";
+			tnrPrev_.erase(stream);
+			return true;
+		}
+	}
+
+	const uint8_t *uv = mapped.planes()[1].data();
+	unsigned int magenta = 0, green = 0, samples = 0;
+	for (size_t i = 0; i + 1 < uvSize; i += 2 * 211) {
+		const int u = uv[i] - 128, v = uv[i + 1] - 128;
+		magenta += u > 40 && v > 40;
+		green += u < -40 && v < -40;
+		samples++;
+	}
+	if (!samples || (magenta * 2 < samples && green * 2 < samples))
+		return false;
+
+	LOG(IPU3, Debug) << "Start-up garbage frame dropped";
+	tnrPrev_.erase(stream);
+	return true;
+}
