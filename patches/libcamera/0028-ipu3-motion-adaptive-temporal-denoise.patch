+			const int *src = sums.data() + static_cast<size_t>(br) * blockCols;
+			int *dst = wide.data() + static_cast<size_t>(br) * blockCols;
+			int left = lut[src[0]], here = left;
+			for (unsigned int bc = 0; bc < blockCols; bc++) {
+				const int right = bc + 1 < blockCols ? lut[src[bc + 1]] : here;
+				dst[bc] = std::max(std::max(left, here), right);
+				left = here;
+				here = right;
+			}
+		}
+	});
+	std::vector<uint8_t> &moving = tnrOrig_[stream];
+	moving.assign(blockRows, 0);
+	parallel(blockRows, [&](unsigned int first, unsigned int last) {
+		for (unsigned int br = first; br < last; br++) {
+			const int *up = wide.data() + static_cast<size_t>(br ? br - 1 : br) * blockCols;
+			const int *mid = wide.data() + static_cast<size_t>(br) * blockCols;
+			const int *down = wide.data() + static_cast<size_t>(br + 1 < blockRows ? br + 1 : br) * blockCols;
+			int *dst = weights.data() + static_cast<size_t>(br) * blockCols;
+			int any = 0;
+			for (unsigned int bc = 0; bc < blockCols; bc++) {
+				dst[bc] = std::max(std::max(up[bc], mid[bc]), down[bc]);
+				any |= dst[bc];
+			}
+			moving[br] = any != 0;
+		}
+	});
+
+	/* The original row just above each band: the band before writes it before the next band reads it. */
+	std::vector<uint8_t> &edges = tnrWork_[stream];
+	edges.resize(static_cast<size_t>(bands) * width);
+	for (unsigned int band = 1; band < bands; band++) {
+		const unsigned int first = blockRows * band / bands * kBlock;
+		std::copy(y + static_cast<size_t>(first - 1) * stride, y + static_cast<size_t>(first - 1) * stride + width,
+			  edges.begin() + static_cast<size_t>(band) * width);
+	}
+
+	parallel(blockRows, [&](unsigned int firstBlock, unsigned int lastBlock) {
+		const unsigned int first = firstBlock * kBlock;
+		const unsigned int last = lastBlock == blockRows ? height : lastBlock * kBlock;
+		std::vector<int16_t> h[3] = { std::vector<int16_t>(width), std::vector<int16_t>(width), std::vector<int16_t>(width) };
+		std::vector<int16_t> w(width), cw(width), expanded[2] = { std::vector<int16_t>(width), std::vector<int16_t>(width) };
+		unsigned int expandedRow[2] = { ~0U, ~0U };
+		auto expandedOf = [&](unsigned int br) -> const int16_t * {
+			for (int i = 0; i < 2; i++)
+				if (expandedRow[i] == br)
+					return expanded[i].data();
+			/* replace the one that is not the other block row in use */
+			const int i = expandedRow[0] == ~0U ? 0 : expandedRow[1] == ~0U ? 1 : expandedRow[0] < expandedRow[1] ? 0 : 1;
+			tnrExpand(weights.data() + static_cast<size_t>(br) * blockCols, blockCols, expanded[i].data(), width);
+			expandedRow[i] = br;
+			return expanded[i].data();
+		};
+
+		/* horizontal sums of the original rows first - 1 (or first) and first */
+		unsigned int band = 0;
+		for (unsigned int b = 1; b < bands; b++)
+			if (blockRows * b / bands == firstBlock)
+				band = b;
+		const uint8_t *above = !first ? y
+				       : band ? edges.data() + static_cast<size_t>(band) * width
+				       : y + static_cast<size_t>(first - 1) * stride;
+		if (spatial) {
+			tnrRowH(above, h[(first + 2) % 3].data(), width);
+			tnrRowH(y + static_cast<size_t>(first) * stride, h[first % 3].data(), width);
+		}
+
+		for (unsigned int r = first; r < last; r++) {
+			const unsigned int next = r + 1 < height ? r + 1 : r;
+			if (next != r && spatial)
+				tnrRowH(y + static_cast<size_t>(next) * stride, h[next % 3].data(), width);	/* still original */
+
+			/* between the centres (4b + 1.5) of the block rows b0 and b0 + 1 */
+			const int pos = static_cast<int>(r) * 2 - 3;
+			const unsigned int b0 = std::min<unsigned int>(pos < 0 ? 0 : pos / 8, blockRows - 1);
+			const unsigned int b1 = std::min(b0 + 1, blockRows - 1);
+			const int fy = pos < 0 ? 0 : (pos % 8) * 32;
+			const bool any = moving[b0] || moving[b1];
+
+			uint8_t *out = y + static_cast<size_t>(r) * stride;
+			uint8_t *old = py + static_cast<size_t>(r) * stride;
+			if (any) {
+				weightsRow(expandedOf(b0), expandedOf(b1), w.data(), fy);
+				if (spatial)
+					row(out, old, h[(r + 2) % 3].data(), h[r % 3].data(), h[next % 3].data(), w.data(), minWeight,
+					    pass, kSpatial);
+				else
+					row(out, old, nullptr, nullptr, nullptr, w.data(), minWeight, pass, 0);
+			} else {
+				stillRow(out, old, minWeight, pass);
+			}
+
+			/* the chroma row of every even luma row, with its weights; the ImgU's XNR3 denoises the chroma itself */
+			if (r & 1)
+				continue;
+			uint8_t *cout = uv + static_cast<size_t>(r / 2) * stride;
+			uint8_t *cold = puv + static_cast<size_t>(r / 2) * stride;
+			if (any) {
+				for (unsigned int x = 0; x + 1 < width; x += 2)
+					cw[x] = cw[x + 1] = w[x];
+				row(cout, cold, nullptr, nullptr, nullptr, cw.data(), minWeight, pass, 0);
+			} else {
+				stillRow(cout, cold, minWeight, pass);
+			}
+		}
+	});
 }
 
