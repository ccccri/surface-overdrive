+/*
+ * Kernels of the temporal denoiser, 16 pixels at a time with SSSE3 (every Surface Go has it), plain loops otherwise.
+ * Weights are in 1/128: 0 is still, 128 is moving. Every kernel writes both the output row and the previous-output row.
+ *
+ *   still  = |cur - prev| >= pass ? cur : prev + minWeight * (cur - prev)	(the temporal average)
+ *   moving = cur + clamp(mean of the 3x3 neighbourhood - cur, -k, k)		(the grain goes, edges stay)
+ *   out    = still + w * (moving - still)
+ */
+
+#if defined(__x86_64__) || defined(__i386__)
+#define TNR_SSSE3 1
+#define TNR_TARGET __attribute__((target("ssse3")))
+
+TNR_TARGET inline __m128i tnrScale(__m128i a, __m128i w)
+{
+	/* w is a weight in 1/128 shifted left by 8 (32767 standing for 128): round(a * weight / 128) */
+	return _mm_mulhrs_epi16(a, w);
+}
+
+TNR_TARGET inline __m128i tnrWeight8(__m128i w)
+{
+	/* w << 8, with 128 (which does not fit) as 32767 */
+	return _mm_sub_epi16(_mm_slli_epi16(w, 8), _mm_srli_epi16(w, 7));
+}
+
+TNR_TARGET inline __m128i tnrStill(__m128i c, __m128i p, __m128i minWeight8, __m128i passMinus1)
+{
+	const __m128i d = _mm_sub_epi16(c, p);
+	const __m128i average = _mm_add_epi16(p, tnrScale(d, minWeight8));
+	const __m128i large = _mm_cmpgt_epi16(_mm_abs_epi16(d), passMinus1);
+	return _mm_or_si128(_mm_and_si128(large, c), _mm_andnot_si128(large, average));
+}
+
+/* Luma row (sums: the horizontal 3-sums of the rows above, here and below) or, without sums, chroma row. */
+TNR_TARGET void tnrRowSsse3(uint8_t *out, uint8_t *prev, const int16_t *up, const int16_t *mid, const int16_t *down,
+			    const int16_t *w, unsigned int n, int minWeight, int pass, int k)
+{
+	const __m128i zero = _mm_setzero_si128();
+	const __m128i minWeight8 = tnrWeight8(_mm_set1_epi16(static_cast<int16_t>(minWeight)));
+	const __m128i passMinus1 = _mm_set1_epi16(static_cast<int16_t>(pass - 1));
+	const __m128i hi = _mm_set1_epi16(static_cast<int16_t>(k)), lo = _mm_set1_epi16(static_cast<int16_t>(-k));
+	const __m128i ninth = _mm_set1_epi16(3641);	/* round(32768 / 9) */
+	unsigned int x = 0;
+	for (; x + 16 <= n; x += 16) {
+		const __m128i c8 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(out + x));
+		const __m128i p8 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(prev + x));
+		__m128i result[2];
+		for (int half = 0; half < 2; half++) {
+			const unsigned int i = x + 8 * half;
+			const __m128i c = half ? _mm_unpackhi_epi8(c8, zero) : _mm_unpacklo_epi8(c8, zero);
+			const __m128i p = half ? _mm_unpackhi_epi8(p8, zero) : _mm_unpacklo_epi8(p8, zero);
+			const __m128i still = tnrStill(c, p, minWeight8, passMinus1);
+			__m128i moving = c;
+			if (up) {
+				const __m128i sum = _mm_add_epi16(_mm_add_epi16(
+					_mm_loadu_si128(reinterpret_cast<const __m128i *>(up + i)),
+					_mm_loadu_si128(reinterpret_cast<const __m128i *>(mid + i))),
+					_mm_loadu_si128(reinterpret_cast<const __m128i *>(down + i)));
+				const __m128i mean = _mm_mulhrs_epi16(sum, ninth);
+				moving = _mm_add_epi16(c, _mm_min_epi16(_mm_max_epi16(_mm_sub_epi16(mean, c), lo), hi));
+			}
+			const __m128i weight8 = tnrWeight8(_mm_loadu_si128(reinterpret_cast<const __m128i *>(w + i)));
+			result[half] = _mm_add_epi16(still, tnrScale(_mm_sub_epi16(moving, still), weight8));
+		}
+		const __m128i r = _mm_packus_epi16(result[0], result[1]);
+		_mm_storeu_si128(reinterpret_cast<__m128i *>(out + x), r);
+		_mm_storeu_si128(reinterpret_cast<__m128i *>(prev + x), r);
+	}
+	for (; x < n; x++) {
+		const int c = out[x], p = prev[x], d = c - p;
+		const int still = (d >= pass || d <= -pass) ? c : p + ((d * minWeight * 256 + 16384) >> 15);
+		int moving = c;
+		if (up) {
+			const int mean = ((up[x] + mid[x] + down[x]) * 3641 + 16384) >> 15;
+			moving = c + std::clamp(mean - c, -k, k);
+		}
+		out[x] = prev[x] = static_cast<uint8_t>(std::clamp(still + (((moving - still) * w[x] + 64) >> 7), 0, 255));
+	}
+}
+
+/* Rows with no motion: the temporal average only. */
+TNR_TARGET void tnrStillSsse3(uint8_t *out, uint8_t *prev, unsigned int n, int minWeight, int pass)
+{
+	const __m128i zero = _mm_setzero_si128();
+	const __m128i minWeight8 = tnrWeight8(_mm_set1_epi16(static_cast<int16_t>(minWeight)));
+	const __m128i passMinus1 = _mm_set1_epi16(static_cast<int16_t>(pass - 1));
+	unsigned int x = 0;
+	for (; x + 16 <= n; x += 16) {
+		const __m128i c8 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(out + x));
+		const __m128i p8 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(prev + x));
+		const __m128i r = _mm_packus_epi16(
+			tnrStill(_mm_unpacklo_epi8(c8, zero), _mm_unpacklo_epi8(p8, zero), minWeight8, passMinus1),
+			tnrStill(_mm_unpackhi_epi8(c8, zero), _mm_unpackhi_epi8(p8, zero), minWeight8, passMinus1));
+		_mm_storeu_si128(reinterpret_cast<__m128i *>(out + x), r);
+		_mm_storeu_si128(reinterpret_cast<__m128i *>(prev + x), r);
+	}
+	for (; x < n; x++) {
+		const int c = out[x], p = prev[x], d = c - p;
+		out[x] = prev[x] = static_cast<uint8_t>((d >= pass || d <= -pass) ? c : p + ((d * minWeight * 256 + 16384) >> 15));
+	}
+}
+
+/* Pixel weights of a row: f / 256 of the way from the expanded block row a to b. */
+TNR_TARGET void tnrWeightsSsse3(const int16_t *a, const int16_t *b, int16_t *w, unsigned int n, int f)
+{
+	const __m128i fa = _mm_set1_epi16(static_cast<int16_t>(std::min((256 - f) << 7, 32767)));
+	const __m128i fb = _mm_set1_epi16(static_cast<int16_t>(std::min(f << 7, 32767)));
+	unsigned int x = 0;
+	for (; x + 8 <= n; x += 8) {
+		const __m128i va = _mm_loadu_si128(reinterpret_cast<const __m128i *>(a + x));
+		const __m128i vb = _mm_loadu_si128(reinterpret_cast<const __m128i *>(b + x));
+		_mm_storeu_si128(reinterpret_cast<__m128i *>(w + x),
+				 _mm_add_epi16(_mm_mulhrs_epi16(va, fa), _mm_mulhrs_epi16(vb, fb)));
+	}
+	for (; x < n; x++)
+		w[x] = static_cast<int16_t>((a[x] * (256 - f) + b[x] * f + 128) >> 8);
+}
+#endif
+
+void tnrRowPlain(uint8_t *out, uint8_t *prev, const int16_t *up, const int16_t *mid, const int16_t *down,
+		 const int16_t *w, unsigned int n, int minWeight, int pass, int k)
+{
+	for (unsigned int x = 0; x < n; x++) {
+		const int c = out[x], p = prev[x], d = c - p;
+		const int still = (d >= pass || d <= -pass) ? c : p + ((d * minWeight * 256 + 16384) >> 15);
+		int moving = c;
+		if (up) {
+			const int mean = ((up[x] + mid[x] + down[x]) * 3641 + 16384) >> 15;
+			moving = c + std::clamp(mean - c, -k, k);
+		}
+		out[x] = prev[x] = static_cast<uint8_t>(std::clamp(still + (((moving - still) * w[x] + 64) >> 7), 0, 255));
+	}
+}
+
+void tnrStillPlain(uint8_t *out, uint8_t *prev, unsigned int n, int minWeight, int pass)
+{
+	for (unsigned int x = 0; x < n; x++) {
+		const int c = out[x], p = prev[x], d = c - p;
+		out[x] = prev[x] = static_cast<uint8_t>((d >= pass || d <= -pass) ? c : p + ((d * minWeight * 256 + 16384) >> 15));
+	}
+}
+
+void tnrWeightsPlain(const int16_t *a, const int16_t *b, int16_t *w, unsigned int n, int f)
+{
+	for (unsigned int x = 0; x < n; x++)
+		w[x] = static_cast<int16_t>((a[x] * (256 - f) + b[x] * f + 128) >> 8);
+}
+
+/* Adds |cur - prev| of every group of 4 pixels of a row to sums[]. */
+__attribute__((optimize("O3"))) void tnrRowSad(const uint8_t *__restrict cur, const uint8_t *__restrict prev,
+						 unsigned int width, int *__restrict sums, uint8_t *__restrict absd)
+{
+	for (unsigned int x = 0; x < width; x++) {
+		const int d = static_cast<int>(cur[x]) - static_cast<int>(prev[x]);
+		absd[x] = static_cast<uint8_t>(d < 0 ? -d : d);
+	}
+	for (unsigned int b = 0; b < width / 4; b++)
+		sums[b] += absd[4 * b] + absd[4 * b + 1] + absd[4 * b + 2] + absd[4 * b + 3];
+}
+
+/* Sum of each pixel of a row with its left and right neighbours (edges counted twice). */
+__attribute__((optimize("O3"))) void tnrRowH(const uint8_t *__restrict src, int16_t *__restrict dst, unsigned int width)
+{
+	for (unsigned int x = 1; x + 1 < width; x++)
+		dst[x] = static_cast<int16_t>(src[x - 1] + src[x] + src[x + 1]);
+	dst[0] = static_cast<int16_t>(src[0] * 2 + src[1]);
+	dst[width - 1] = static_cast<int16_t>(src[width - 2] + src[width - 1] * 2);
+}
+
+/* Block weights (0..256) of a block row to pixel weights (0..128), linear between block centres (4b + 1.5). */
+void tnrExpand(const int *weights, unsigned int blocks, int16_t *w, unsigned int width)
+{
+	for (unsigned int b = 0; b < blocks; b++) {
+		const int l = weights[b ? b - 1 : b], m = weights[b], r = weights[b + 1 < blocks ? b + 1 : b];
+		w[4 * b + 0] = static_cast<int16_t>((l * 3 + m * 5 + 8) >> 4);
+		w[4 * b + 1] = static_cast<int16_t>((l + m * 7 + 8) >> 4);
+		w[4 * b + 2] = static_cast<int16_t>((r + m * 7 + 8) >> 4);
+		w[4 * b + 3] = static_cast<int16_t>((r * 3 + m * 5 + 8) >> 4);
+	}
+	for (unsigned int x = 4 * blocks; x < width; x++)
+		w[x] = w[4 * blocks - 1];
+}
