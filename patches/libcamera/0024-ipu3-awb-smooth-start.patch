 	cellsPerZoneThreshold_ = cellsPerZoneX_ * cellsPerZoneY_ * kMaxCellSaturationRatio;
 	LOG(IPU3Awb, Debug) << "Threshold for AWB is set to " << cellsPerZoneThreshold_;
 
+	/*
+	 * Where the white balance starts. Gains of 1 show the sensor's own colour, which is green, until the first frames
+	 * bright enough to measure (a second or more while the exposure settles). Start instead from where the previous
+	 * session ended, or the first time from the middle of the locus (an ordinary indoor light).
+	 */
+	if (!haveLast_ && !locus_.empty()) {
+		const auto &mid = locus_[locus_.size() / 2];
+		lastRedGain_ = std::exp(-mid.first);
+		lastBlueGain_ = std::exp(-mid.second);
+	}
+	asyncResults_.redGain = lastRedGain_;
