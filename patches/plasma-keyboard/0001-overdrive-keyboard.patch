new file mode 100644
index 0000000..94ee685
--- /dev/null
+++ b/src/screenlock.h
@@ -0,0 +1,38 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <qqmlintegration.h>
+
+/**
+ * Whether the screen is locked (org.freedesktop.ScreenSaver of the session).
+ *
+ * The floating keyboard lives in a window of its own, which the compositor does not show above the lock screen: while
+ * the screen is locked the keyboard has to be the docked one, or there would be nothing to type the password with.
+ * When the answer is not known, the screen counts as locked: the docked keyboard is the one that always shows.
+ */
+class ScreenLock : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    Q_PROPERTY(bool locked READ locked NOTIFY lockedChanged)
+
+public:
+    explicit ScreenLock(QObject *parent = nullptr);
+
+    bool locked() const { return m_locked; }
+
+Q_SIGNALS:
+    void lockedChanged();
+
+private Q_SLOTS:
+    void activeChanged(bool active);
+
+private:
+    bool m_locked = true;
+};
