--- /dev/null
+++ b/src/qml/KeyboardMenu.qml
@@ -0,0 +1,116 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.keyboard.lib as PlasmaKeyboard
+
+// The keyboard's own menu, opened by holding the space bar: what the keyboard is (floating, split) and what it shows
+// (the extra keys, the clipboard, the emoji). An entry is chosen by sliding onto it and lifting the finger, or by a tap.
+Item {
+    id: menu
+
+    property bool floating: false
+    property bool split: false
+    property bool extraKeys: false
+    // False on an upright screen, where the keyboard is never split
+    property bool splitPossible: true
+    // Index of the entry under the finger that still holds the space bar (-1: none)
+    property int hovered: -1
+
+    signal triggered(string name)
+
+    readonly property var theme: PlasmaKeyboard.BreezeConstants
+    readonly property real cellWidth: Kirigami.Units.gridUnit * 4.6
+    readonly property real cellHeight: Kirigami.Units.gridUnit * 3.6
+
+    readonly property var entries: [
+        {name: "floating", icon: "window-duplicate", text: menu.floating ? i18n("Dock") : i18n("Float"), checked: menu.floating, enabled: true},
+        {name: "split", icon: "view-split-left-right", text: i18n("Split"), checked: menu.split && !menu.floating && menu.splitPossible, enabled: !menu.floating && menu.splitPossible},
+        {name: "extra", icon: "input-keyboard", text: i18n("Extra keys"), checked: menu.extraKeys, enabled: true},
+        {name: "clipboard", icon: "edit-paste", text: i18n("Clipboard"), checked: false, enabled: true},
+        {name: "emoji", icon: "smiley", text: i18n("Emoji"), checked: false, enabled: true},
+        {name: "settings", icon: "configure", text: i18n("Settings"), checked: false, enabled: true}
+    ]
+
+    implicitWidth: cellWidth * entries.length + Kirigami.Units.smallSpacing * 2
+    implicitHeight: cellHeight + Kirigami.Units.smallSpacing * 2
+
+    // The entry at a point of this item, for the finger that slides up from the space bar
+    function indexAt(x, y) {
+        if (y < -cellHeight * 0.5 || y > height + cellHeight * 0.5) {
+            return -1;
+        }
+        const index = Math.floor((x - Kirigami.Units.smallSpacing) / cellWidth);
+        return index >= 0 && index < entries.length && entries[index].enabled ? index : -1;
+    }
+
+    function trigger(index) {
+        if (index >= 0 && index < entries.length && entries[index].enabled) {
+            menu.triggered(entries[index].name);
+        }
+    }
+
+    PlasmaKeyboard.BreezePopup {
+        anchors.fill: parent
+        theme: menu.theme
+    }
+
+    Row {
+        anchors.centerIn: parent
+
+        Repeater {
+            model: menu.entries
+
+            Item {
+                id: cell
+                required property var modelData
+                required property int index
+                width: menu.cellWidth
+                height: menu.cellHeight
+                opacity: modelData.enabled ? 1 : 0.35
+
+                Rectangle {
+                    anchors.fill: parent
+                    anchors.margins: Kirigami.Units.smallSpacing / 2
+                    radius: menu.theme.buttonRadius
+                    color: (cellArea.pressed || menu.hovered === cell.index) ? menu.theme.popupHighlightColor : "transparent"
+                    border.width: cell.modelData.checked ? 2 : 0
+                    border.color: Kirigami.Theme.highlightColor
+                }
+                Column {
+                    anchors.centerIn: parent
+                    spacing: Kirigami.Units.smallSpacing / 2
+
+                    Kirigami.Icon {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        source: cell.modelData.icon
+                        width: Kirigami.Units.iconSizes.smallMedium
+                        height: width
+                        color: menu.theme.popupTextColor
+                    }
+                    QQC2.Label {
+                        anchors.horizontalCenter: parent.horizontalCenter
+                        width: menu.cellWidth - Kirigami.Units.smallSpacing * 2
+                        horizontalAlignment: Text.AlignHCenter
+                        elide: Text.ElideRight
+                        text: cell.modelData.text
+                        color: menu.theme.popupTextColor
+                        font.family: menu.theme.fontFamily
+                        font.pixelSize: Kirigami.Theme.smallFont.pixelSize
+                    }
+                }
+                MouseArea {
+                    id: cellArea
+                    anchors.fill: parent
+                    enabled: cell.modelData.enabled
+                    onClicked: menu.trigger(cell.index)
+                }
+            }
+        }
+    }
+}
diff --git a/src/qml/SpaceGesture.qml b/src/qml/SpaceGesture.qml
new file mode 100644
index 0000000..7884d70
--- /dev/null
+++ b/src/qml/SpaceGesture.qml
@@ -0,0 +1,106 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+// Lies over the space bar and gives it three uses: a tap types a space, a slide moves the text cursor, a hold opens
+// the keyboard's menu (which can then be chosen from without lifting the finger).
+MultiPointTouchArea {
+    id: area
+
+    // A slide of this length is one step of the cursor
+    property real stepSize: 20
+    property real radius: 0
+
+    signal tapped()
+    signal cursorStep(int direction)
+    signal menuRequested()
+    signal menuMoved(real x, real y)
+    signal menuReleased(real x, real y)
+
+    property bool held: false
+    property bool cursorMode: false
+    property bool menuMode: false
+    property real startX: 0
+    property real lastStepX: 0
+
+    maximumTouchPoints: 1
+    mouseEnabled: true
+
+    function stop() {
+        hold.stop();
+        held = false;
+        cursorMode = false;
+        menuMode = false;
+    }
+
+    Timer {
+        id: hold
+        interval: 550
+        onTriggered: {
+            if (area.held && !area.cursorMode) {
+                area.menuMode = true;
+                area.menuRequested();
+            }
+        }
+    }
+
+    onPressed: (points) => {
+        const p = points[0];
+        held = true;
+        cursorMode = false;
+        menuMode = false;
+        startX = p.x;
+        lastStepX = p.x;
+        hold.restart();
+    }
+    onUpdated: (points) => {
+        const p = points[0];
+        if (!held) {
+            return;
+        }
+        if (menuMode) {
+            area.menuMoved(p.x, p.y);
+            return;
+        }
+        if (!cursorMode && Math.abs(p.x - startX) > stepSize * 1.5) {
+            cursorMode = true;
+            hold.stop();
+            lastStepX = p.x;
+        }
+        if (cursorMode) {
+            while (p.x - lastStepX >= stepSize) {
+                lastStepX += stepSize;
+                area.cursorStep(1);
+            }
+            while (lastStepX - p.x >= stepSize) {
+                lastStepX -= stepSize;
+                area.cursorStep(-1);
+            }
+        }
+    }
+    onReleased: (points) => {
+        const p = points[0];
+        const wasMenu = menuMode;
+        const wasCursor = cursorMode;
+        const wasHeld = held;
+        stop();
+        if (wasMenu) {
+            area.menuReleased(p.x, p.y);
+        } else if (wasHeld && !wasCursor) {
+            area.tapped();
+        }
+    }
+    onCanceled: stop()
+
+    Rectangle {
+        anchors.fill: parent
+        radius: area.radius
+        visible: area.held
+        color: Qt.rgba(Kirigami.Theme.highlightColor.r, Kirigami.Theme.highlightColor.g, Kirigami.Theme.highlightColor.b, area.cursorMode ? 0.35 : 0.2)
+    }
+}
