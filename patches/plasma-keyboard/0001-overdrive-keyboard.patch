diff --git a/src/qml/ExtraKeyRow.qml b/src/qml/ExtraKeyRow.qml
new file mode 100644
index 0000000..fb96b41
--- /dev/null
+++ b/src/qml/ExtraKeyRow.qml
@@ -0,0 +1,131 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.keyboard.lib as PlasmaKeyboard
+
+// The row of keys a touch keyboard otherwise lacks, above the letters: Esc, Tab, Ctrl, Alt, Meta, the arrows, Home,
+// End, the page keys, Delete, and the function keys on a second page. Ctrl, Alt and Meta are armed by a tap and hold
+// for the next key, of this row or of the keyboard below (Ctrl then "c").
+Item {
+    id: row
+
+    // The ExtraKeys device
+    required property var keys
+    property real scaleHint: 1
+    property bool functionPage: false
+
+    signal clipboardRequested()
+
+    readonly property var theme: PlasmaKeyboard.BreezeConstants
+
+    // t: label, i: icon, k: key name of ExtraKeys.code(), m: modifier property, a: action, r: repeats while held
+    readonly property var mainPage: [
+        {t: "Esc", k: "esc"}, {t: "Tab", k: "tab"},
+        {t: "Ctrl", m: "ctrl"}, {t: "Alt", m: "alt"}, {t: "Meta", m: "meta"},
+        {t: "←", k: "left", r: true}, {t: "↓", k: "down", r: true}, {t: "↑", k: "up", r: true}, {t: "→", k: "right", r: true},
+        {t: "Home", k: "home"}, {t: "End", k: "end"}, {t: "PgUp", k: "pgup", r: true}, {t: "PgDn", k: "pgdn", r: true},
+        {t: "Del", k: "del", r: true}, {t: "Fn", a: "fn"}, {i: "edit-paste", a: "clipboard"}
