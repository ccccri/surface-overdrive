diff --git a/src/qml/ClipboardList.qml b/src/qml/ClipboardList.qml
new file mode 100644
index 0000000..c27b690
--- /dev/null
+++ b/src/qml/ClipboardList.qml
@@ -0,0 +1,105 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+import QtQuick
+import QtQuick.Controls as QQC2
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.keyboard.lib as PlasmaKeyboard
+
+// The last texts of Plasma's clipboard, above the keyboard: a tap types one into the focused field.
+Item {
+    id: list
+
+    property var entries: []
+
+    signal chosen(string text)
+    signal closeRequested()
+
+    readonly property var theme: PlasmaKeyboard.BreezeConstants
+    readonly property real rowHeight: Kirigami.Units.gridUnit * 2.2
+
+    implicitHeight: Math.max(1, Math.min(entries.length, 5)) * rowHeight + header.height + Kirigami.Units.smallSpacing * 3
+
+    PlasmaKeyboard.BreezePopup {
+        anchors.fill: parent
+        theme: list.theme
+    }
+
+    Item {
+        id: header
+        anchors { top: parent.top; left: parent.left; right: parent.right; margins: Kirigami.Units.smallSpacing }
+        height: Kirigami.Units.gridUnit * 1.8
+
+        QQC2.Label {
+            anchors { left: parent.left; leftMargin: Kirigami.Units.largeSpacing; verticalCenter: parent.verticalCenter }
+            text: i18n("Clipboard")
+            color: list.theme.popupTextColor
+            font.family: list.theme.fontFamily
+            font.bold: true
+        }
+        Item {
+            anchors { right: parent.right; top: parent.top; bottom: parent.bottom }
+            width: height * 1.4
+
+            Kirigami.Icon {
+                anchors.centerIn: parent
+                source: "window-close"
+                width: Kirigami.Units.iconSizes.small
+                height: width
+                color: list.theme.popupTextColor
+            }
+            MouseArea {
+                anchors.fill: parent
+                onClicked: list.closeRequested()
+            }
+        }
+    }
+
+    QQC2.Label {
+        anchors.centerIn: view
+        visible: list.entries.length === 0
+        text: i18n("Nothing was copied yet")
+        color: list.theme.popupTextColor
+        opacity: 0.7
+        font.family: list.theme.fontFamily
+    }
+
+    ListView {
+        id: view
+        anchors { top: header.bottom; left: parent.left; right: parent.right; bottom: parent.bottom; margins: Kirigami.Units.smallSpacing }
+        clip: true
+        boundsBehavior: Flickable.StopAtBounds
+        model: list.entries
+
+        delegate: Item {
+            id: entry
+            required property string modelData
+            width: view.width
+            height: list.rowHeight
+
+            Rectangle {
+                anchors.fill: parent
+                anchors.margins: 1
+                radius: list.theme.buttonRadius
+                color: entryArea.pressed ? list.theme.popupHighlightColor : "transparent"
+            }
+            QQC2.Label {
+                anchors { left: parent.left; right: parent.right; verticalCenter: parent.verticalCenter; margins: Kirigami.Units.largeSpacing }
+                // one line of it: what is typed is the whole text
+                text: entry.modelData.replace(/\s+/g, " ").trim()
+                elide: Text.ElideRight
+                maximumLineCount: 1
+                color: list.theme.popupTextColor
+                font.family: list.theme.fontFamily
+            }
+            MouseArea {
+                id: entryArea
+                anchors.fill: parent
+                onClicked: list.chosen(entry.modelData)
+            }
+        }
+    }
+}
