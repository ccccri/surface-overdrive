@@ -0,0 +1,225 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "extrakeys.h"
+
+#include "logging.h"
+
+#include <QDateTime>
+#include <QHash>
+#include <QThread>
+
+#include <cstring>
+#include <fcntl.h>
+#include <linux/uinput.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+// The compositor needs a moment to take a new keyboard in: keys sent sooner are lost
+static const int SETTLE_MS = 350;
+
+static const QHash<QString, int> &names()
+{
+    static const QHash<QString, int> table = {
+        {QStringLiteral("esc"), KEY_ESC},          {QStringLiteral("tab"), KEY_TAB},
+        {QStringLiteral("left"), KEY_LEFT},        {QStringLiteral("right"), KEY_RIGHT},
+        {QStringLiteral("up"), KEY_UP},            {QStringLiteral("down"), KEY_DOWN},
+        {QStringLiteral("home"), KEY_HOME},        {QStringLiteral("end"), KEY_END},
+        {QStringLiteral("pgup"), KEY_PAGEUP},      {QStringLiteral("pgdn"), KEY_PAGEDOWN},
+        {QStringLiteral("del"), KEY_DELETE},       {QStringLiteral("ins"), KEY_INSERT},
+        {QStringLiteral("enter"), KEY_ENTER},      {QStringLiteral("backspace"), KEY_BACKSPACE},
+        {QStringLiteral("space"), KEY_SPACE},      {QStringLiteral("print"), KEY_SYSRQ},
+        {QStringLiteral("f1"), KEY_F1},            {QStringLiteral("f2"), KEY_F2},
+        {QStringLiteral("f3"), KEY_F3},            {QStringLiteral("f4"), KEY_F4},
+        {QStringLiteral("f5"), KEY_F5},            {QStringLiteral("f6"), KEY_F6},
+        {QStringLiteral("f7"), KEY_F7},            {QStringLiteral("f8"), KEY_F8},
+        {QStringLiteral("f9"), KEY_F9},            {QStringLiteral("f10"), KEY_F10},
+        {QStringLiteral("f11"), KEY_F11},          {QStringLiteral("f12"), KEY_F12},
+        {QStringLiteral("a"), KEY_A}, {QStringLiteral("b"), KEY_B}, {QStringLiteral("c"), KEY_C}, {QStringLiteral("d"), KEY_D},
+        {QStringLiteral("e"), KEY_E}, {QStringLiteral("f"), KEY_F}, {QStringLiteral("g"), KEY_G}, {QStringLiteral("h"), KEY_H},
+        {QStringLiteral("i"), KEY_I}, {QStringLiteral("j"), KEY_J}, {QStringLiteral("k"), KEY_K}, {QStringLiteral("l"), KEY_L},
+        {QStringLiteral("m"), KEY_M}, {QStringLiteral("n"), KEY_N}, {QStringLiteral("o"), KEY_O}, {QStringLiteral("p"), KEY_P},
+        {QStringLiteral("q"), KEY_Q}, {QStringLiteral("r"), KEY_R}, {QStringLiteral("s"), KEY_S}, {QStringLiteral("t"), KEY_T},
+        {QStringLiteral("u"), KEY_U}, {QStringLiteral("v"), KEY_V}, {QStringLiteral("w"), KEY_W}, {QStringLiteral("x"), KEY_X},
+        {QStringLiteral("y"), KEY_Y}, {QStringLiteral("z"), KEY_Z},
+        {QStringLiteral("1"), KEY_1}, {QStringLiteral("2"), KEY_2}, {QStringLiteral("3"), KEY_3}, {QStringLiteral("4"), KEY_4},
+        {QStringLiteral("5"), KEY_5}, {QStringLiteral("6"), KEY_6}, {QStringLiteral("7"), KEY_7}, {QStringLiteral("8"), KEY_8},
+        {QStringLiteral("9"), KEY_9}, {QStringLiteral("0"), KEY_0},
+        {QStringLiteral(" "), KEY_SPACE},          {QStringLiteral("\n"), KEY_ENTER},
+    };
+    return table;
+}
+
+ExtraKeys::ExtraKeys(QObject *parent)
+    : QObject(parent)
+{
+}
+
+ExtraKeys::~ExtraKeys()
+{
+    if (m_fd >= 0) {
+        ioctl(m_fd, UI_DEV_DESTROY);
+        close(m_fd);
+    }
+}
+
+bool ExtraKeys::open()
+{
+    if (m_fd >= 0) {
+        return true;
+    }
+    if (m_failed) {
+        return false;
+    }
+    int fd = ::open("/dev/uinput", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        qCWarning(PlasmaKeyboard) << "No extra keys: /dev/uinput cannot be opened:" << strerror(errno);
+        m_failed = true;
+        Q_EMIT availableChanged();
+        return false;
+    }
+    bool ok = ioctl(fd, UI_SET_EVBIT, EV_KEY) >= 0;
+    for (int key = KEY_ESC; ok && key <= KEY_F24; ++key) {
+        ok = ioctl(fd, UI_SET_KEYBIT, key) >= 0;
+    }
+    struct uinput_setup setup;
+    memset(&setup, 0, sizeof(setup));
+    setup.id.bustype = BUS_VIRTUAL;
+    setup.id.vendor = 0x1d6b;
+    setup.id.product = 0x0104;
+    strncpy(setup.name, "Plasma Keyboard extra keys", UINPUT_MAX_NAME_SIZE - 1);
+    ok = ok && ioctl(fd, UI_DEV_SETUP, &setup) >= 0 && ioctl(fd, UI_DEV_CREATE) >= 0;
+    if (!ok) {
+        qCWarning(PlasmaKeyboard) << "No extra keys: the keyboard device cannot be made:" << strerror(errno);
+        close(fd);
+        m_failed = true;
+        Q_EMIT availableChanged();
+        return false;
+    }
+    m_fd = fd;
+    m_readyAt = QDateTime::currentMSecsSinceEpoch() + SETTLE_MS;
+    return true;
+}
+
+bool ExtraKeys::available()
+{
+    return !m_failed;
+}
+
+void ExtraKeys::prepare()
+{
+    open();
+}
+
+void ExtraKeys::emitKey(int key, int value)
+{
+    struct input_event event;
+    memset(&event, 0, sizeof(event));
+    event.type = EV_KEY;
+    event.code = key;
+    event.value = value;
+    if (write(m_fd, &event, sizeof(event)) != sizeof(event)) {
+        qCWarning(PlasmaKeyboard) << "An extra key was not written:" << strerror(errno);
+    }
+    sync();
+}
+
+void ExtraKeys::sync()
+{
+    struct input_event event;
+    memset(&event, 0, sizeof(event));
+    event.type = EV_SYN;
+    event.code = SYN_REPORT;
+    (void)!write(m_fd, &event, sizeof(event));
+}
+
+void ExtraKeys::tap(int key)
+{
+    if (key <= 0 || !open()) {
+        return;
+    }
+    // only the very first key after the device was made waits
+    const qint64 wait = m_readyAt - QDateTime::currentMSecsSinceEpoch();
+    if (wait > 0) {
+        QThread::msleep(wait);
+    }
+    const int held[] = {m_ctrl ? KEY_LEFTCTRL : 0, m_alt ? KEY_LEFTALT : 0, m_meta ? KEY_LEFTMETA : 0, m_shift ? KEY_LEFTSHIFT : 0};
+    for (int modifier : held) {
+        if (modifier) {
+            emitKey(modifier, 1);
+        }
+    }
+    emitKey(key, 1);
+    emitKey(key, 0);
+    for (int modifier : held) {
+        if (modifier) {
+            emitKey(modifier, 0);
+        }
+    }
+    clearModifiers();
+}
+
+int ExtraKeys::code(const QString &name) const
+{
+    return names().value(name.toLower(), 0);
+}
+
+bool ExtraKeys::typeWithModifiers(const QString &text)
+{
+    if (!anyArmed()) {
+        return false;
+    }
+    const int key = code(text);
+    if (!key || !open()) {
+        // nothing to hold the modifiers with: they are dropped, the text goes on as text
+        clearModifiers();
+        return false;
+    }
+    tap(key);
+    return true;
+}
+
+void ExtraKeys::clearModifiers()
+{
+    if (!anyArmed()) {
+        return;
+    }
+    m_ctrl = m_alt = m_meta = m_shift = false;
+    Q_EMIT modifiersChanged();
+}
+
+void ExtraKeys::setCtrl(bool on)
+{
+    if (m_ctrl != on) {
+        m_ctrl = on;
+        Q_EMIT modifiersChanged();
+    }
+}
+
+void ExtraKeys::setAlt(bool on)
+{
+    if (m_alt != on) {
+        m_alt = on;
+        Q_EMIT modifiersChanged();
+    }
+}
+
+void ExtraKeys::setMeta(bool on)
+{
+    if (m_meta != on) {
+        m_meta = on;
+        Q_EMIT modifiersChanged();
+    }
+}
+
+void ExtraKeys::setShift(bool on)
+{
+    if (m_shift != on) {
+        m_shift = on;
+        Q_EMIT modifiersChanged();
+    }
+}
+
+#include "moc_extrakeys.cpp"
diff --git a/src/extrakeys.h b/src/extrakeys.h
new file mode 100644
index 0000000..cd0e8bc
--- /dev/null
+++ b/src/extrakeys.h
@@ -0,0 +1,76 @@
+/*
+    SPDX-FileCopyrightText: 2026 Surface Overdrive
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <qqmlintegration.h>
+
+/**
+ * Keys that text input cannot carry: Esc, Tab, arrows, function keys, and Ctrl, Alt and Meta held with another key.
+ *
+ * An input method can only hand text and bare key symbols to the compositor (KWin drops the modifiers of a key symbol
+ * for most applications), so these keys are typed on a keyboard device of our own (/dev/uinput, which the desktop user
+ * of the seat may open). The device is made at the first use.
+ *
+ * Ctrl, Alt, Meta and Shift are "armed" by a tap and held for the next key only, whichever keyboard it comes from: the
+ * key row above the letters (tap()) or a letter of the keyboard itself (typeWithModifiers(), asked by
+ * InputListenerItem before it commits text).
+ */
+class ExtraKeys : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    Q_PROPERTY(bool ctrl READ ctrl WRITE setCtrl NOTIFY modifiersChanged)
+    Q_PROPERTY(bool alt READ alt WRITE setAlt NOTIFY modifiersChanged)
+    Q_PROPERTY(bool meta READ meta WRITE setMeta NOTIFY modifiersChanged)
+    Q_PROPERTY(bool shift READ shift WRITE setShift NOTIFY modifiersChanged)
+    /** False when the device could not be made (no /dev/uinput, or not ours to open). */
+    Q_PROPERTY(bool available READ available NOTIFY availableChanged)
+
+public:
+    explicit ExtraKeys(QObject *parent = nullptr);
+    ~ExtraKeys() override;
+
+    bool ctrl() const { return m_ctrl; }
+    bool alt() const { return m_alt; }
+    bool meta() const { return m_meta; }
+    bool shift() const { return m_shift; }
+    void setCtrl(bool on);
+    void setAlt(bool on);
+    void setMeta(bool on);
+    void setShift(bool on);
+    bool anyArmed() const { return m_ctrl || m_alt || m_meta || m_shift; }
+    bool available();
+
+    /** Makes the device ahead of the first key, so that the compositor knows it by then. */
+    Q_INVOKABLE void prepare();
+    /** One key (a Linux key code, KEY_*) with the armed modifiers, which are then released. */
+    Q_INVOKABLE void tap(int key);
+    /** The key code of a name of the key row ("esc", "left", "f5", "c"...), 0 when unknown. */
+    Q_INVOKABLE int code(const QString &name) const;
+    /** Types `text` (one letter or digit) with the armed modifiers; false when nothing is armed or it has no key. */
+    bool typeWithModifiers(const QString &text);
+
+Q_SIGNALS:
+    void modifiersChanged();
+    void availableChanged();
+
+private:
+    bool open();
+    void emitKey(int key, int value);
+    void sync();
+    void clearModifiers();
+
+    int m_fd = -1;
+    bool m_failed = false;
+    qint64 m_readyAt = 0;
+    bool m_ctrl = false;
+    bool m_alt = false;
+    bool m_meta = false;
+    bool m_shift = false;
+};
