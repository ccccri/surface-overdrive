diff --git a/drivers/media/i2c/ov8865.c b/drivers/media/i2c/ov8865.c
index fdd8408..1d709fd 100644
--- a/drivers/media/i2c/ov8865.c
+++ b/drivers/media/i2c/ov8865.c
@@ -766,6 +766,34 @@ static const struct ov8865_pll2_config ov8865_pll2_config_native_24mhz = {
  * SCLK = 72 MHz
  */
 
+/*
+ * Experimental: full resolution at 30 fps instead of 15. The native modes clock the sensor array (SCLK) at 144 MHz,
+ * which with their 3888 x 2470 frame timing gives exactly 15 frames a second; 288 MHz gives 30. PLL2 then runs its VCO
+ * at 720 MHz (as in the binned modes) and divides it by 2.5; DAC_CLK stays at 360 MHz. The four MIPI lanes at 720 Mbps
+ * carry a 3264-pixel line in 11.3 us, within the 13.5 us of a line at 30 fps. Off by default; with a 19.2 MHz external
+ * clock only (the Surface Go). Read when a format is set, so a change applies the next time the camera starts.
+ *
+ * DAC_CLK = 360 MHz
+ * SCLK = 288 MHz
+ */
+static unsigned int native_sclk_mhz = 144;
+module_param(native_sclk_mhz, uint, 0644);
+MODULE_PARM_DESC(native_sclk_mhz, "Sensor clock of the full resolution modes in MHz: 144 (15 fps, default) or 288 (30 fps, experimental)");
+
+static const struct ov8865_pll2_config ov8865_pll2_config_native_fast_19_2mhz = {
+	.pll_pre_div_half	= 1,
+	.pll_pre_div		= 2,
+	.pll_mul		= 75,
+	.dac_div		= 2,
+	.sys_pre_div		= 1,
+	.sys_div		= 3,
+};
+
+static bool ov8865_native_fast(const struct ov8865_sensor *sensor, const struct ov8865_mode *mode)
+{
+	return !mode->pll2_binning && native_sclk_mhz == 288 && sensor->extclk_rate == 19200000;
+}
+
 static const struct ov8865_pll2_config ov8865_pll2_config_binning_19_2mhz = {
 	.pll_pre_div_half	= 1,
 	.pll_pre_div		= 2,
@@ -1623,6 +1651,8 @@ static int ov8865_mode_pll2_configure(struct ov8865_sensor *sensor,
 
 	config = mode->pll2_binning ? sensor->pll_configs->pll2_config_binning :
 				      sensor->pll_configs->pll2_config_native;
+	if (ov8865_native_fast(sensor, mode))
+		config = &ov8865_pll2_config_native_fast_19_2mhz;
 
 	ret = ov8865_write(sensor, OV8865_PLL_CTRL12_REG,
 			   OV8865_PLL_CTRL12_PRE_DIV_HALF(config->pll_pre_div_half) |
@@ -2242,7 +2272,8 @@ static int ov8865_state_mipi_configure(struct ov8865_sensor *sensor,
 	 * 2 (native) times too short: the auto exposure believed it exposed for 8.3 ms while the sensor integrated for
 	 * the whole 33 ms frame.
 	 */
-	mipi_pixel_rate /= mode->pll2_binning ? 4 : 2;
+	if (!ov8865_native_fast(sensor, mode))
+		mipi_pixel_rate /= mode->pll2_binning ? 4 : 2;
 
 	__v4l2_ctrl_s_ctrl_int64(ctrls->pixel_rate, mipi_pixel_rate);
 
