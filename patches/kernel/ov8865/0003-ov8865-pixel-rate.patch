--- a/drivers/media/i2c/ov8865.c	2026-09-30 23:10:08.119857796 +0200
+++ b/drivers/media/i2c/ov8865.c	2026-09-30 23:10:08.174857798 +0200
@@ -2289,6 +2289,18 @@
 	lanes_count = bus_mipi_csi2->num_data_lanes;
 	mipi_pixel_rate = mipi_clk_rate * 2 * lanes_count / bits_per_sample;
 
+	/*
+	 * The figure above is derived from the MIPI link, not from the clock that drives the sensor timing, and it is too
+	 * high. Measured on the Surface Go: the binned mode (hts 1923, vts 1248) delivers 30 frames a second, so its pixel
+	 * clock is 72 MHz, a quarter of the MIPI figure; the full resolution modes (hts 3888, vts 2470) deliver exactly
+	 * 15 frames a second, so theirs is 144 MHz, half of it. Those are the two rates of PLL2, which clocks the sensor
+	 * array: the binned modes run it at half the rate of the native ones. Userspace (libcamera) derives line duration,
+	 * exposure time and frame duration from the pixel rate, so with the MIPI figure every time came out 4 (binned) or
+	 * 2 (native) times too short: the auto exposure believed it exposed for 8.3 ms while the sensor integrated for
+	 * the whole 33 ms frame.
+	 */
+	mipi_pixel_rate /= mode->pll2_binning ? 4 : 2;
+
 	__v4l2_ctrl_s_ctrl_int64(ctrls->pixel_rate, mipi_pixel_rate);
 
 	return 0;
